//@version=6
indicator("MTF DOM Candle Bias Box [Ratio 1:1.5] V2.1", shorttitle="MTF DOM Candle Bias V2.1", overlay=false)

// ================================================================================
// MTF DOM Candle-based Buy/Sell Bias Box - PRODUCTION V2.1
// BULLISH BIAS: Price ABOVE WMA(1440) + Buy/Sell Ratio > 1.5
// BEARISH BIAS: Price BELOW WMA(1440) + Buy/Sell Ratio < 1.0
// Alerts + Debug Table + WMA Visualization
// ================================================================================

// ================================================================================
// INPUT PARAMETERS
// ================================================================================

mtf_timeframe = input.timeframe("5", title="MTF DOM Timeframe (DOM Analysis)")
wma_length = input.int(1440, title="WMA Length (Trend Confirmation)", minval=1, maxval=1500)
bullish_ratio_threshold = input.float(1.5, title="Bullish Ratio Threshold (Buy:Sell)", minval=1.0, step=0.1)
bearish_ratio_threshold = input.float(1.0, title="Bearish Ratio Threshold (Buy:Sell)", minval=0.1, step=0.1)
show_debug_table = input.bool(true, title="Show Debug Info Table")
show_wma_plot = input.bool(true, title="Show WMA(1440) & Price Plot")
alert_enabled = input.bool(true, title="Enable Alerts")

// ================================================================================
// FETCH MTF DOM CANDLE DATA
// ================================================================================

mtf_open = request.security(syminfo.tickerid, mtf_timeframe, open)
mtf_high = request.security(syminfo.tickerid, mtf_timeframe, high)
mtf_low = request.security(syminfo.tickerid, mtf_timeframe, low)
mtf_close = request.security(syminfo.tickerid, mtf_timeframe, close)
mtf_volume = request.security(syminfo.tickerid, mtf_timeframe, volume)

// ================================================================================
// WMA TREND CALCULATION (1 MIN Timeframe)
// ================================================================================

wma_1440 = request.security(syminfo.tickerid, "1", ta.wma(close, wma_length))
current_price = close

// ================================================================================
// DOM-BASED VOLUME RATIO ANALYSIS
// ================================================================================

// DOM Candle Interpretation:
// - Upper wick = Rejected buying pressure (supply)
// - Lower wick = Rejected selling pressure (demand)
// - Body = Net directional volume

// Buy/Sell Volume Proxies
mtf_buy_volume = math.max(mtf_high - mtf_open, 0) * mtf_volume
mtf_sell_volume = math.max(mtf_open - mtf_low, 0) * mtf_volume

// Safe division (avoid division by zero)
mtf_sell_volume_safe = mtf_sell_volume > 0 ? mtf_sell_volume : 0.001
mtf_buy_volume_safe = mtf_buy_volume > 0 ? mtf_buy_volume : 0.001

// Calculate ratios
buy_sell_ratio = mtf_buy_volume_safe / mtf_sell_volume_safe
sell_buy_ratio = mtf_sell_volume_safe / mtf_buy_volume_safe

// ================================================================================
// TREND DETECTION (WMA-based)
// ================================================================================

price_above_wma = mtf_close > wma_1440
price_below_wma = mtf_close < wma_1440
wma_bullish_trend = price_above_wma
wma_bearish_trend = price_below_wma

// ================================================================================
// NEW BIAS DETECTION LOGIC (V2.1)
// ================================================================================

// BULLISH BIAS CONDITION (Green Emoji: 🔴 🟢 🟢):
// Trend is BULLISH (Price > WMA(1440))
// AND Buy/Sell Ratio > 1.5 (Strong Buying Pressure)
bullish_bias_confirmed = wma_bullish_trend and buy_sell_ratio > bullish_ratio_threshold

// BEARISH BIAS CONDITION (Red Emoji: 🟢 🔴 🔴):
// Trend is BEARISH (Price < WMA(1440))
// AND Buy/Sell Ratio < 1.0 (Strong Selling Pressure)
bearish_bias_confirmed = wma_bearish_trend and buy_sell_ratio < bearish_ratio_threshold

// NEUTRAL: Neither condition met
neutral_bias = not bullish_bias_confirmed and not bearish_bias_confirmed

// ================================================================================
// COLOR DEFINITIONS
// ================================================================================

color_bullish = color.new(color.green, 20)
color_bearish = color.new(color.red, 20)
color_neutral = color.new(color.gray, 40)
color_bullish_border = color.new(color.green, 0)
color_bearish_border = color.new(color.red, 0)
color_neutral_border = color.new(color.gray, 0)

// ================================================================================
// DETERMINE BIAS STATUS & MESSAGING WITH EMOJIS
// ================================================================================

bias_color = bullish_bias_confirmed ? color_bullish : bearish_bias_confirmed ? color_bearish : color_neutral
bias_border_color = bullish_bias_confirmed ? color_bullish_border : bearish_bias_confirmed ? color_bearish_border : color_neutral_border

// Emoji message display: 🔴 🟢 🟢 for BULLISH, 🟢 🔴 🔴 for BEARISH
bias_message = bullish_bias_confirmed ? "BULLISH 🔴 🟢 🟢" : bearish_bias_confirmed ? "BEARISH 🟢 🔴 🔴" : "NEUTRAL ⚪"

// ================================================================================
// BIAS BOX VISUALIZATION
// ================================================================================

var box bias_box = na

if barstate.islast
    // Update or create bias box
    if not na(bias_box)
        box.set_bgcolor(bias_box, bias_color)
        box.set_border_color(bias_box, bias_border_color)
        box.set_border_width(bias_box, 2)
        box.set_text(bias_box, bias_message)
    else
        bias_box := box.new(
             left=bar_index - 50,
             top=1.0,
             right=bar_index + 5,
             bottom=0.0,
             bgcolor=bias_color,
             border_color=bias_border_color,
             border_width=2,
             text=bias_message,
             text_size=size.large,
             text_color=color.white,
             text_halign=text.align_center,
             text_valign=text.align_center
             )

// ================================================================================
// WMA BAND VISUALIZATION
// ================================================================================

plot(show_wma_plot ? wma_1440 : na, title="WMA(1440) Trend", color=color.orange, linewidth=2)
plot(show_wma_plot ? current_price : na, title="Current Price", color=color.white, linewidth=1)

// ================================================================================
// DEBUG INFO TABLE (Bottom-Right)
// ================================================================================

if show_debug_table and barstate.islast
    table_position = table.new(
         position=position.bottom_right,
         columns=2,
         rows=9,
         bgcolor=color.new(color.black, 20),
         border_color=color.white,
         border_width=1
         )
    
    // Row 1: Bias Status
    table.cell(table_position, 0, 0, text="[BIAS]", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black, 50))
    table.cell(table_position, 1, 0, text=bias_message, text_color=color.white, text_size=size.normal, bgcolor=bias_color)
    
    // Row 2: Buy/Sell Ratio
    table.cell(table_position, 0, 1, text="Buy:Sell Ratio", text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 1, text=str.tostring(buy_sell_ratio, "0.00"), text_color=color.yellow, text_size=size.normal)
    
    // Row 3: Trend Status
    table.cell(table_position, 0, 2, text="Trend Status", text_color=color.white, text_size=size.normal)
    trend_text = wma_bullish_trend ? "🟢 BULLISH" : wma_bearish_trend ? "🔴 BEARISH" : "⚪ NEUTRAL"
    trend_color = wma_bullish_trend ? color.green : wma_bearish_trend ? color.red : color.gray
    table.cell(table_position, 1, 2, text=trend_text, text_color=trend_color, text_size=size.normal)
    
    // Row 4: Ratio Thresholds
    table.cell(table_position, 0, 3, text="Bullish Threshold", text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 3, text=str.tostring(bullish_ratio_threshold, "0.00"), text_color=color.orange, text_size=size.normal)
    
    // Row 5: Bearish Threshold
    table.cell(table_position, 0, 4, text="Bearish Threshold", text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 4, text=str.tostring(bearish_ratio_threshold, "0.00"), text_color=color.orange, text_size=size.normal)
    
    // Row 6: WMA Value
    table.cell(table_position, 0, 5, text="WMA(1440)", text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 5, text=str.tostring(wma_1440, "0.00"), text_color=color.orange, text_size=size.normal)
    
    // Row 7: Current Price
    table.cell(table_position, 0, 6, text="CMP", text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 6, text=str.tostring(current_price, "0.00"), text_color=color.white, text_size=size.normal)
    
    // Row 8: Confirmation Status
    table.cell(table_position, 0, 7, text="Confirmation", text_color=color.white, text_size=size.normal)
    confirm_text = bullish_bias_confirmed ? "✓ BULLISH CONF" : bearish_bias_confirmed ? "✓ BEARISH CONF" : "✗ NEUTRAL"
    confirm_color = bullish_bias_confirmed ? color.green : bearish_bias_confirmed ? color.red : color.gray
    table.cell(table_position, 1, 7, text=confirm_text, text_color=confirm_color, text_size=size.normal)
    
    // Row 9: MTF & Volume
    table.cell(table_position, 0, 8, text=str.format("MTF: {0}", mtf_timeframe), text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 8, text=str.format("Vol: {0}", str.tostring(mtf_volume, "0")), text_color=color.yellow, text_size=size.normal)

// ================================================================================
// ALERTS
// ================================================================================

if alert_enabled
    // Bullish Bias Alert (trigger once per confirmation)
    if bullish_bias_confirmed and not bullish_bias_confirmed[1]
        alert("🟢 MTF DOM: BULLISH BIAS CONFIRMED 🔴🟢🟢 | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)
    
    // Bearish Bias Alert (trigger once per confirmation)
    if bearish_bias_confirmed and not bearish_bias_confirmed[1]
        alert("🔴 MTF DOM: BEARISH BIAS CONFIRMED 🟢🔴🔴 | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)

// ================================================================================
// REFERENCE VARIABLES FOR DEBUGGING
// ================================================================================
// bias_message: Shows emoji-encoded bias state
// buy_sell_ratio: Key metric for ratio-based bias confirmation
// wma_1440: Trend anchor (bullish if price > WMA, bearish if price < WMA)
