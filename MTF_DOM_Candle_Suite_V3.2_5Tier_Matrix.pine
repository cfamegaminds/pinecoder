//@version=6
indicator("MTF DOM Candle Suite V3.2 - 5-Tier Matrix", overlay=false)

// ================================================================================
// MTF DOM Candle-based 5-Tier Bias Classification Matrix
// PRODUCTION V3.2
// ================================================================================
// Strong Bull (🟢 🟢 🟢): Ratio >= 2.5 + Bullish Trend
// Neutral Bull (⚪ 🟢 🟢): Ratio 1.5-2.5 + Bullish Trend
// Neutral (⚪ ⚪ ⚪): Ratio 1.0-1.5
// Neutral Bear (⚪ 🔴 🔴): Ratio 0.75-1.0 + Bearish Trend
// Strong Bear (🔴 🔴 🔴): Ratio 0.01-0.75 + Bearish Trend
// ================================================================================

// ================================================================================
// INPUT PARAMETERS
// ================================================================================

mtf_timeframe = input.timeframe("15", title="MTF DOM Timeframe (DOM Analysis)")
wma_length = input.int(1440, title="WMA Length (Trend Confirmation)", minval=1, maxval=1500)

// Ratio thresholds for 5-tier matrix
strong_bull_threshold = input.float(2.5, title="Strong Bull Threshold (Buy:Sell)", minval=1.5, step=0.01)
neutral_bull_threshold = input.float(1.5, title="Neutral Bull Threshold (Buy:Sell)", minval=1.0, step=0.01)
neutral_threshold = input.float(1.0, title="Neutral Range (1.0-1.5)")
neutral_bear_threshold = input.float(0.75, title="Neutral Bear Threshold (Buy:Sell)", minval=0.01, maxval=1.0, step=0.01)
strong_bear_min = input.float(0.01, title="Strong Bear Min (Buy:Sell)", minval=0.01, maxval=1.0, step=0.01)

show_debug_table = input.bool(true, title="Show Debug Info Table")
show_wma_plot = input.bool(true, title="Show WMA(1440) & Price Plot")
alert_enabled = input.bool(true, title="Enable Alerts")

// ================================================================================
// FETCH MTF DOM CANDLE DATA
// ================================================================================

mtf_open = request.security(syminfo.tickerid, mtf_timeframe, open)
mtf_high = request.security(syminfo.tickerid, mtf_timeframe, high)
mtf_low = request.security(syminfo.tickerid, mtf_timeframe, low)
mtf_close = request.security(syminfo.tickerid, mtf_timeframe, close)
mtf_volume = request.security(syminfo.tickerid, mtf_timeframe, volume)

// ================================================================================
// WMA TREND CALCULATION (1 MIN Timeframe)
// ================================================================================

wma_1440 = request.security(syminfo.tickerid, "1", ta.wma(close, wma_length))
current_price = close

// ================================================================================
// DOM-BASED VOLUME RATIO ANALYSIS
// ================================================================================

// DOM Candle Interpretation:
// - Upper wick = Rejected buying pressure (supply)
// - Lower wick = Rejected selling pressure (demand)
// - Body = Net directional volume

// Buy/Sell Volume Proxies
mtf_buy_volume = math.max(mtf_high - mtf_open, 0) * mtf_volume
mtf_sell_volume = math.max(mtf_open - mtf_low, 0) * mtf_volume

// Safe division (avoid division by zero)
mtf_sell_volume_safe = mtf_sell_volume > 0 ? mtf_sell_volume : 0.001
mtf_buy_volume_safe = mtf_buy_volume > 0 ? mtf_buy_volume : 0.001

// Calculate ratios
buy_sell_ratio = mtf_buy_volume_safe / mtf_sell_volume_safe

// ================================================================================
// TREND DETECTION (WMA-based)
// ================================================================================

price_above_wma = mtf_close > wma_1440
price_below_wma = mtf_close < wma_1440
wma_bullish_trend = price_above_wma
wma_bearish_trend = price_below_wma

// ================================================================================
// 5-TIER BIAS CLASSIFICATION LOGIC (V3.2)
// ================================================================================

// STRONG BULLISH (🟢 🟢 🟢):
// Buy/Sell Ratio >= 2.5 AND Price > WMA(1440)
strong_bull = (buy_sell_ratio >= strong_bull_threshold) and wma_bullish_trend

// NEUTRAL BULLISH (⚪ 🟢 🟢):
// Buy/Sell Ratio 1.5-2.5 AND Price > WMA(1440)
neutral_bull = (buy_sell_ratio >= neutral_bull_threshold and buy_sell_ratio < strong_bull_threshold) and wma_bullish_trend

// NEUTRAL (⚪ ⚪ ⚪):
// Buy/Sell Ratio 1.0-1.5 (regardless of trend)
neutral = (buy_sell_ratio >= neutral_threshold and buy_sell_ratio < neutral_bull_threshold)

// NEUTRAL BEARISH (⚪ 🔴 🔴):
// Buy/Sell Ratio 0.75-1.0 AND Price < WMA(1440)
neutral_bear = (buy_sell_ratio >= neutral_bear_threshold and buy_sell_ratio < neutral_threshold) and wma_bearish_trend

// STRONG BEARISH (🔴 🔴 🔴):
// Buy/Sell Ratio 0.01-0.75 AND Price < WMA(1440)
strong_bear = (buy_sell_ratio >= strong_bear_min and buy_sell_ratio < neutral_bear_threshold) and wma_bearish_trend

// ================================================================================
// COLOR DEFINITIONS
// ================================================================================

color_strong_bull = color.new(color.green, 10)
color_neutral_bull = color.new(color.green, 40)
color_neutral = color.new(color.gray, 50)
color_neutral_bear = color.new(color.red, 40)
color_strong_bear = color.new(color.red, 10)

color_strong_bull_border = color.new(color.green, 0)
color_neutral_bull_border = color.new(color.green, 0)
color_neutral_border = color.new(color.gray, 0)
color_neutral_bear_border = color.new(color.red, 0)
color_strong_bear_border = color.new(color.red, 0)

// ================================================================================
// DETERMINE BIAS STATUS & MESSAGING WITH EMOJIS
// ================================================================================

bias_color = strong_bull ? color_strong_bull : 
             neutral_bull ? color_neutral_bull : 
             neutral ? color_neutral : 
             neutral_bear ? color_neutral_bear : 
             strong_bear ? color_strong_bear : color_neutral

bias_border_color = strong_bull ? color_strong_bull_border : 
                    neutral_bull ? color_neutral_bull_border : 
                    neutral ? color_neutral_border : 
                    neutral_bear ? color_neutral_bear_border : 
                    strong_bear ? color_strong_bear_border : color_neutral_border

bias_message = strong_bull ? "BULLISH 🟢 🟢 🟢" : 
               neutral_bull ? "BULLISH ⚪ 🟢 🟢" : 
               neutral ? "NEUTRAL ⚪ ⚪ ⚪" : 
               neutral_bear ? "BEARISH ⚪ 🔴 🔴" : 
               strong_bear ? "BEARISH 🔴 🔴 🔴" : "NEUTRAL ⚪ ⚪ ⚪"

// ================================================================================
// BIAS BOX VISUALIZATION
// ================================================================================

var box bias_box = na

if barstate.islast
    // Update or create bias box
    if not na(bias_box)
        box.set_bgcolor(bias_box, bias_color)
        box.set_border_color(bias_box, bias_border_color)
        box.set_border_width(bias_box, 2)
        box.set_text(bias_box, bias_message)
    else
        bias_box := box.new(
             left=bar_index - 50,
             top=1.0,
             right=bar_index + 5,
             bottom=0.0,
             bgcolor=bias_color,
             border_color=bias_border_color,
             border_width=2,
             text=bias_message,
             text_size=size.large,
             text_color=color.white,
             text_halign=text.align_center,
             text_valign=text.align_center
             )

// ================================================================================
// WMA BAND VISUALIZATION
// ================================================================================

plot(show_wma_plot ? wma_1440 : na, title="WMA(1440) Trend", color=color.orange, linewidth=2)
plot(show_wma_plot ? current_price : na, title="Current Price", color=color.white, linewidth=1)

// ================================================================================
// DEBUG INFO TABLE (Bottom-Right)
// ================================================================================

if show_debug_table and barstate.islast
    table_position = table.new(
         position=position.bottom_right,
         columns=2,
         rows=9,
         bgcolor=color.new(color.black, 20),
         border_color=color.white,
         border_width=1
         )
    
    // Row 1: Bias Status
    table.cell(table_position, 0, 0, text="[BIAS]", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.black, 50))
    table.cell(table_position, 1, 0, text=bias_message, text_color=color.white, text_size=size.normal, bgcolor=bias_color)
    
    // Row 2: Buy/Sell Ratio
    table.cell(table_position, 0, 1, text="Buy:Sell Ratio", text_color=color.white, text_size=size.normal)
    ratio_color = strong_bull ? color.green : neutral_bull ? color.new(color.green, 50) : neutral ? color.gray : neutral_bear ? color.new(color.red, 50) : color.red
    table.cell(table_position, 1, 1, text=str.tostring(buy_sell_ratio, "0.00"), text_color=ratio_color, text_size=size.normal)
    
    // Row 3: Trend Status
    table.cell(table_position, 0, 2, text="Trend Status", text_color=color.white, text_size=size.normal)
    trend_text = wma_bullish_trend ? "🟢 🟢 🟢" : wma_bearish_trend ? "🔴 🔴 🔴" : "⚪ NEUTRAL"
    trend_color = wma_bullish_trend ? color.green : wma_bearish_trend ? color.red : color.gray
    table.cell(table_position, 1, 2, text=trend_text, text_color=trend_color, text_size=size.normal)
    
    // Row 4: Classification Tier
    table.cell(table_position, 0, 3, text="Tier", text_color=color.white, text_size=size.normal)
    tier_text = strong_bull ? "Strong Bull" : neutral_bull ? "Neutral Bull" : neutral ? "Neutral" : neutral_bear ? "Neutral Bear" : strong_bear ? "Strong Bear" : "Unknown"
    tier_color = strong_bull ? color.green : neutral_bull ? color.new(color.green, 50) : neutral ? color.gray : neutral_bear ? color.new(color.red, 50) : color.red
    table.cell(table_position, 1, 3, text=tier_text, text_color=tier_color, text_size=size.normal)
    
    // Row 5: WMA Value
    table.cell(table_position, 0, 4, text="WMA(1440)", text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 4, text=str.tostring(wma_1440, "0.00"), text_color=color.orange, text_size=size.normal)
    
    // Row 6: Current Price
    table.cell(table_position, 0, 5, text="CMP", text_color=color.white, text_size=size.normal)
    price_vs_wma_color = wma_bullish_trend ? color.green : wma_bearish_trend ? color.red : color.gray
    table.cell(table_position, 1, 5, text=str.tostring(current_price, "0.00"), text_color=price_vs_wma_color, text_size=size.normal)
    
    // Row 7: Ratio Range Info
    table.cell(table_position, 0, 6, text="Ratio Range", text_color=color.white, text_size=size.normal)
    range_text = strong_bull ? "≥2.5" : neutral_bull ? "1.5-2.5" : neutral ? "1.0-1.5" : neutral_bear ? "0.75-1.0" : strong_bear ? "0.01-0.75" : "N/A"
    table.cell(table_position, 1, 6, text=range_text, text_color=color.yellow, text_size=size.normal)
    
    // Row 8: Confirmation Status
    table.cell(table_position, 0, 7, text="Confirmation", text_color=color.white, text_size=size.normal)
    confirm_text = strong_bull ? "🟢🟢🟢🟢🟢" : neutral_bull ? "⚪🟢🟢⚪⚪" : neutral ? "⚪⚪⚪⚪⚪" : neutral_bear ? "⚪🔴🔴⚪⚪" : strong_bear ? "🔴🔴🔴🔴🔴" : "⚪⚪⚪"
    confirm_color = strong_bull ? color.green : neutral_bull ? color.new(color.green, 50) : neutral ? color.gray : neutral_bear ? color.new(color.red, 50) : color.red
    table.cell(table_position, 1, 7, text=confirm_text, text_color=confirm_color, text_size=size.normal)
    
    // Row 9: MTF & Volume
    table.cell(table_position, 0, 8, text=str.format("MTF: {0}", mtf_timeframe), text_color=color.white, text_size=size.normal)
    table.cell(table_position, 1, 8, text=str.format("Vol: {0}", str.tostring(mtf_volume, "0")), text_color=color.yellow, text_size=size.normal)

// ================================================================================
// ALERTS
// ================================================================================

if alert_enabled
    // Strong Bullish Alert
    if strong_bull and not strong_bull[1]
        alert("🟢 STRONG BULL 🟢 🟢 🟢 | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)
    
    // Neutral Bullish Alert
    if neutral_bull and not neutral_bull[1]
        alert("🟢 NEUTRAL BULL ⚪ 🟢 🟢 | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)
    
    // Neutral Alert
    if neutral and not neutral[1]
        alert("⚪ NEUTRAL ⚪ ⚪ ⚪ | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1", alert.freq_once_per_bar_close)
    
    // Neutral Bearish Alert
    if neutral_bear and not neutral_bear[1]
        alert("🔴 NEUTRAL BEAR ⚪ 🔴 🔴 | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)
    
    // Strong Bearish Alert
    if strong_bear and not strong_bear[1]
        alert("🔴 STRONG BEAR 🔴 🔴 🔴 | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)

// ================================================================================
// REFERENCE VARIABLES FOR DEBUGGING
// ================================================================================
// 5-Tier Classification:
// strong_bull: Ratio >= 2.5 + Bullish Trend (🟢 🟢 🟢)
// neutral_bull: Ratio 1.5-2.5 + Bullish Trend (⚪ 🟢 🟢)
// neutral: Ratio 1.0-1.5 (⚪ ⚪ ⚪)
// neutral_bear: Ratio 0.75-1.0 + Bearish Trend (⚪ 🔴 🔴)
// strong_bear: Ratio 0.01-0.75 + Bearish Trend (🔴 🔴 🔴)
