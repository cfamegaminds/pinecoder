//@version=6
indicator("FRVP + RPOC Confluence Engine[3:30] V1.1", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000)

// ════════════════════════════════════════════════════════
// ── SECTION 1 : FRVP INPUTS  (POCF)
// ════════════════════════════════════════════════════════
rows           = input.int(24,    "Profile Rows",        minval=10, maxval=100)
profilesToShow = input.int(30,    "Profiles To Plot",    minval=1,  maxval=50)
pocWidth       = input.int(4,     "POC Width",           minval=1,  maxval=10)
pocColor       = input.color(color.blue, "POC Color")
extendIntoNext = input.bool(true, "Extend POC Across Next Session")

// ════════════════════════════════════════════════════════
// ── SECTION 2 : RPOC INPUTS  (POCR)
// ════════════════════════════════════════════════════════
resInput       = input.timeframe("D", "Segment Resolution", options=["D","W","M"])
minBars        = input.int(1,    "Minimum Bars Required",   minval=1)
binsCount      = input.int(480,  "Volume Profile Bins",     minval=10)
pocThreshold   = input.float(0.0,"POC Update Threshold %",  step=0.01,
     tooltip="POC only updates when new value differs by more than this % from previous POC.")
smoothedLength = input.int(60,   "POC Smoothing Length",    minval=1)
updateMinutes  = input.int(1440, "POC Update Interval (Minutes)", minval=1)
profilePoc     = input.color(color.red, "RPOC Color")
rpocWidth      = input.int(4,    "RPOC Line Width",         minval=1, maxval=10)

// ════════════════════════════════════════════════════════
// ── SECTION 3 : FRVP SESSION TRACKING
// ════════════════════════════════════════════════════════
string tz    = "Asia/Kolkata"
newSession   = hour(time, tz) == 3 and minute(time, tz) == 30

var int[] sessionStarts = array.new_int()
var int[] sessionEnds   = array.new_int()

if newSession
    if array.size(sessionStarts) > array.size(sessionEnds)
        array.push(sessionEnds, bar_index - 1)
    array.push(sessionStarts, bar_index)
    while array.size(sessionStarts) > profilesToShow + 1
        array.shift(sessionStarts)
    while array.size(sessionEnds) > profilesToShow
        array.shift(sessionEnds)

// ════════════════════════════════════════════════════════
// ── SECTION 4 : FRVP POC / VAH / VAL CALCULATION
// ════════════════════════════════════════════════════════
calcProfileLevels(_startBar, _endBar, _rows) =>
    float hi = na
    float lo = na
    safeStart = math.max(_startBar, bar_index - 4999)

    for i = safeStart to _endBar
        barsBack = bar_index - i
        if barsBack >= 0 and barsBack < 5000
            hi := na(hi) ? high[barsBack] : math.max(hi, high[barsBack])
            lo := na(lo) ? low[barsBack]  : math.min(lo, low[barsBack])

    if na(hi) or na(lo)
        [na, na, na, na, na]
    else
        myRange    = math.max(hi - lo, syminfo.mintick)
        step       = myRange / _rows
        volumeRows = array.new_float(_rows, 0.0)
        totalVol   = 0.0

        for i = safeStart to _endBar
            barsBack = bar_index - i
            if barsBack >= 0 and barsBack < 5000
                barHigh  = high[barsBack]
                barLow   = low[barsBack]
                barVol   = volume[barsBack]
                totalVol += barVol
                barRange = math.max(barHigh - barLow, syminfo.mintick)

                for r = 0 to _rows - 1
                    rowLow  = lo + step * r
                    rowHigh = rowLow + step
                    overlap = math.max(math.min(barHigh, rowHigh) - math.max(barLow, rowLow), 0)
                    if overlap > 0
                        array.set(volumeRows, r, array.get(volumeRows, r) + barVol * (overlap / barRange))

        maxVol = 0.0
        pocRow = 0
        for r = 0 to _rows - 1
            rowVol = array.get(volumeRows, r)
            if rowVol > maxVol
                maxVol := rowVol
                pocRow := r

        poc = lo + step * pocRow + step * 0.5

        // ── True 79% Value Area ──
        targetVol = totalVol * 0.79
        valueVol  = maxVol
        vahRow    = pocRow
        valRow    = pocRow
        upRow     = pocRow + 1
        downRow   = pocRow - 1

        while valueVol < targetVol and (upRow < _rows or downRow >= 0)
            volUp   = upRow   < _rows and upRow   >= 0 ? array.get(volumeRows, upRow)   : 0.0
            volDown = downRow >= 0     and downRow < _rows ? array.get(volumeRows, downRow) : 0.0

            if volUp >= volDown
                if upRow < _rows
                    valueVol += volUp
                    vahRow    := upRow
                    upRow     += 1
                else
                    if downRow >= 0
                        valueVol += volDown
                        valRow    := downRow
                        downRow   -= 1
            else
                if downRow >= 0
                    valueVol += volDown
                    valRow    := downRow
                    downRow   -= 1
                else
                    if upRow < _rows
                        valueVol += volUp
                        vahRow    := upRow
                        upRow     += 1

        vah = lo + step * vahRow + step
        val = lo + step * valRow

        [poc, vah, val, hi, lo]

// ════════════════════════════════════════════════════════
// ── SECTION 5 : RPOC CALCULATION
// ════════════════════════════════════════════════════════
isNewSegment  = timeframe.change(resInput)
var int segmentStart = bar_index

if isNewSegment
    segmentStart := bar_index

segmentLength = bar_index - segmentStart + 1
devHigh       = ta.highest(high, segmentLength)
devLow        = ta.lowest(low,  segmentLength)

float rawPocPrice = na
range_  = devHigh - devLow
stepR   = range_ / binsCount
binsVol = array.new_float(binsCount, 0.0)

for i = 0 to binsCount - 1
    array.set(binsVol, i, 0.0)

if segmentLength >= minBars and range_ > 0 and stepR > 0
    for i = 0 to segmentLength - 1
        price = close[i]
        vol   = volume[i]
        idx   = math.floor((price - devLow) / stepR)
        idx  := math.max(0, math.min(binsCount - 1, idx))
        array.set(binsVol, idx, array.get(binsVol, idx) + vol)

    maxVolR  = array.max(binsVol)
    pocIndex = array.indexof(binsVol, maxVolR)
    if pocIndex >= 0
        rawPocPrice := devLow + (stepR * pocIndex) + (stepR / 2)

var float smoothedRawPoc    = na
var float currentStablePoc  = na
var int   lastUpdateTime    = na

if isNewSegment
    currentStablePoc := na
    smoothedRawPoc   := na
    lastUpdateTime   := na

if not na(rawPocPrice)
    smoothedRawPoc := na(smoothedRawPoc) ? rawPocPrice : ((smoothedRawPoc * (smoothedLength - 1)) + rawPocPrice) / smoothedLength

updateIntervalMs = updateMinutes * 60 * 1000
canUpdate        = na(lastUpdateTime) or ((time - lastUpdateTime) >= updateIntervalMs)

if not na(smoothedRawPoc)
    if na(currentStablePoc)
        currentStablePoc := smoothedRawPoc
        lastUpdateTime   := time
    else
        diffPercent = math.abs(smoothedRawPoc - currentStablePoc) / currentStablePoc * 100
        if canUpdate and diffPercent > pocThreshold
            currentStablePoc := smoothedRawPoc
            lastUpdateTime   := time

float POCR = currentStablePoc

// ════════════════════════════════════════════════════════
// ── SECTION 6 : DAY OPEN LEVEL
// ════════════════════════════════════════════════════════
isNewDay       = timeframe.change("D")
var float dayOpen = na
if isNewDay or na(dayOpen)
    dayOpen := open
float DayOpenLevel = dayOpen

// ════════════════════════════════════════════════════════
// ── SECTION 7 : FRVP TABLE  (POC / P1 / D1 / Bias)
// ════════════════════════════════════════════════════════
var table controlTable = table.new(position.bottom_left, 2, 5, border_width=1)

// Persistent vars to carry POCF + bias + VAL into the bias-box section
var float POCF       = na
var float VAL_Last   = na   // D1 (VAL) level carried into Section 8
var bool  isBullish  = false
var bool  isBearish  = false
var bool  isBalanced = false

if barstate.islast and array.size(sessionEnds) > 0
    latestStart = array.get(sessionStarts, math.min(array.size(sessionStarts)-1, array.size(sessionEnds)-1))
    latestEnd   = array.get(sessionEnds, array.size(sessionEnds)-1)

    [pocNow, vahNow, valNow, hiNow, loNow] = calcProfileLevels(latestStart, latestEnd, rows)

    if not na(pocNow)
        POCF     := pocNow
        VAL_Last := valNow  // capture D1 (VAL) for selloff check

        pocP1Range = math.abs(vahNow - pocNow)
        pocD1Range = math.abs(pocNow - valNow)

        isBullish  := pocP1Range > pocD1Range * 1.25
        isBearish  := pocD1Range > pocP1Range * 1.25
        isBalanced := not isBullish and not isBearish

        boxColor = isBullish ? color.new(color.green, 0) : isBearish ? color.new(color.red, 0) : color.new(color.orange, 0)
        bias     = isBullish ? "▲ Bullish" : isBearish ? "▼ Bearish" : "◆ Balanced"

        table.cell(controlTable, 0, 0, "FRVP Levels",                bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.large)
        table.cell(controlTable, 1, 0, "Value",                      bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.large)
        table.cell(controlTable, 0, 1, "POC",                        bgcolor=color.new(color.blue,  20), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 1, str.tostring(pocNow, "#.##"), bgcolor=color.new(color.blue,  20), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 0, 2, "P1 (VAH)",                   bgcolor=color.new(color.green, 30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 2, str.tostring(vahNow, "#.##"), bgcolor=color.new(color.green, 30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 0, 3, "D1 (VAL)",                   bgcolor=color.new(color.red,   30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 3, str.tostring(valNow, "#.##"), bgcolor=color.new(color.red,   30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 0, 4, "Bias",                       bgcolor=boxColor,                   text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 4, bias,                         bgcolor=boxColor,                   text_color=color.white, text_size=size.normal)

// ════════════════════════════════════════════════════════
// ── SECTION 8 : BIAS INFO BOX  (bottom-right)
// ════════════════════════════════════════════════════════
// 4-row table: header | line1 | line2 | selloff warning (conditional)
var table biasBox = table.new(position.bottom_right, 1, 4, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

if barstate.islast and not na(POCF) and not na(POCR) and not na(DayOpenLevel)
    highLevel = math.max(POCF, POCR)
    lowLevel  = math.min(POCF, POCR)
    highDay   = math.max(POCF, DayOpenLevel)
    lowDay    = math.min(POCF, DayOpenLevel)

    highLevelStr = str.tostring(highLevel, "#.##")
    lowLevelStr  = str.tostring(lowLevel,  "#.##")
    highDayStr   = str.tostring(highDay,   "#.##")
    lowDayStr    = str.tostring(lowDay,    "#.##")

    if isBearish
        headerText = "⚠ BEARISH BIAS"
        line1Text  = "Sellers in Control below " + lowLevelStr
        line2Text  = "Buyers back in Control above " + highLevelStr
        hdrColor   = color.new(color.red, 10)
        l1Color    = color.new(color.red, 30)
        l2Color    = color.new(color.green, 40)

        table.cell(biasBox, 0, 0, headerText, bgcolor=hdrColor, text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 1, line1Text,  bgcolor=l1Color,  text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 2, line2Text,  bgcolor=l2Color,  text_color=color.white, text_size=size.large)

        // ── Row 3 : Selloff warning when POCR < D1 (VAL) ──
        if not na(VAL_Last) and POCR < VAL_Last
            table.cell(biasBox, 0, 3, "🔻 Selloff Expected!!!", bgcolor=color.new(color.red, 0), text_color=color.white, text_size=size.large)
        else
            table.cell(biasBox, 0, 3, "", bgcolor=color.new(color.black, 100), text_color=color.white, text_size=size.normal)

    else if isBullish
        headerText = "✔ BULLISH BIAS"
        line1Text  = "Buyers in Control above " + highLevelStr
        line2Text  = "Sellers back in Control below " + lowLevelStr
        hdrColor   = color.new(color.green, 10)
        l1Color    = color.new(color.green, 30)
        l2Color    = color.new(color.red,   40)

        table.cell(biasBox, 0, 0, headerText, bgcolor=hdrColor, text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 1, line1Text,  bgcolor=l1Color,  text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 2, line2Text,  bgcolor=l2Color,  text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 3, "",         bgcolor=color.new(color.black, 100), text_color=color.white, text_size=size.normal)

    else if isBalanced
        headerText = "◆ BALANCED BIAS"
        line1Text  = "Buyers in Control above " + highDayStr
        line2Text  = "Sellers back in Control below " + lowDayStr
        hdrColor   = color.new(color.orange, 10)
        l1Color    = color.new(color.green,  40)
        l2Color    = color.new(color.red,    40)

        table.cell(biasBox, 0, 0, headerText, bgcolor=hdrColor, text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 1, line1Text,  bgcolor=l1Color,  text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 2, line2Text,  bgcolor=l2Color,  text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 3, "",         bgcolor=color.new(color.black, 100), text_color=color.white, text_size=size.normal)

// ════════════════════════════════════════════════════════
// ── SECTION 9 : PLOTS
// ════════════════════════════════════════════════════════
plot(isNewSegment ? na : POCR, title="RPOC (POCR)", color=profilePoc, linewidth=rpocWidth, style=plot.style_line)
