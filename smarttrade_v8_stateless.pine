// @version=6
indicator("Smart Trading Suite V8.0 STATE MACHINE", overlay=false, max_lines_count=100, max_boxes_count=50, max_labels_count=500, max_bars_back=5000)

// STATE CONSTANTS
STATE_STRONG_BUY = "STRONG BUY"
STATE_ACCUMULATION = "ACCUMULATION"
STATE_SIDEWAYS = "SIDEWAYS"
STATE_DISTRIBUTION = "DISTRIBUTION"
STATE_STRONG_SELL = "STRONG SELL"

// MTF DOM SIGNALS (from confluence)
SIGNAL_STRONG_BULL = 1.0
SIGNAL_BULL = 0.5
SIGNAL_NEUTRAL = 0.0
SIGNAL_BEAR = -0.5
SIGNAL_STRONG_BEAR = -1.0

// DELTA LINE COLOR STATES
DELTA_GREEN = 1.0
DELTA_BLACK = 0.0
DELTA_RED = -1.0

// SESSION CONFIG
string sessionTZ = input.string("Asia/Kolkata", "Session TZ", group="Session")
int sessHour = input.int(3, "Session Start Hour", minval=0, maxval=23, group="Session")
int sessMinute = input.int(30, "Session Start Minute", minval=0, maxval=59, group="Session")

// MTF CONFIG
int mtfLookback = input.int(20, "MTF Lookback", minval=5, maxval=100, group="MTF_DOM")

// POCX2 CONFIG (kept for MTF calc only, no weighting)
int pocRows = input.int(20, "POCX2 Rows", minval=10, maxval=50, group="POCX2")
int pocLookback = input.int(500, "POCX2 Lookback", minval=50, maxval=500, group="POCX2")

// DISPLAY
bool showState = input.bool(true, "Show Trend State", group="Display")

// STATE VARIABLES
var float sessionDelta = 0.0
var float sessionHigh = na
var float sessionLow = na
var int barsInSession = 0
var float lockedSessionVAL = na
var float lockedSessionVAH = na
var bool sessionLocked = false

var float mtfDomSignal = SIGNAL_NEUTRAL
var float mtfConfidence = 0.0

var string trendState = STATE_SIDEWAYS
var color trendColor = color.gray
var float deltaLineColor = DELTA_BLACK

var table stateBox = na

// UTILITY FUNCTIONS
f_clamp(float val, float minVal, float maxVal) =>
    math.max(minVal, math.min(maxVal, val))

f_is_valid(float x) =>
    not na(x)

f_session_phase() =>
    curHour = hour(time, sessionTZ)
    curMin = minute(time, sessionTZ)
    if na(curHour) or na(curMin)
        -1
    else
        hrsElapsed = (curHour - sessHour + 24) % 24
        if curMin < sessMinute and hrsElapsed > 0
            hrsElapsed - 1
        else
            hrsElapsed

f_is_new_session() =>
    h = hour(time, sessionTZ)
    m = minute(time, sessionTZ)
    not na(h) and not na(m) and h == sessHour and m == sessMinute

// SESSION DELTA ACCUMULATION
f_session_delta_accumulate() =>
    isNewSession = f_is_new_session()
    isUp = close > open
    isDown = close < open
    buyVol = isUp ? math.max(volume, 0.0) : 0.0
    sellVol = isDown ? math.max(volume, 0.0) : 0.0
    barDelta = buyVol - sellVol
    if isNewSession
        [barDelta, high, low, 1]
    else
        newDelta = sessionDelta + barDelta
        clampedDelta = f_clamp(newDelta, -10000.0, 10000.0)
        newHigh = math.max(sessionHigh, high)
        newLow = math.min(sessionLow, low)
        newBars = barsInSession + 1
        [clampedDelta, newHigh, newLow, newBars]

// DETERMINE DELTA LINE COLOR STATE
f_delta_line_color() =>
    if sessionDelta > 0
        DELTA_GREEN
    else if sessionDelta < 0
        DELTA_RED
    else
        DELTA_BLACK

// MTF DOMINANCE (CONFLUENCE CHECK)
f_mtf_dom_single_tf(int lookback) =>
    if lookback <= 0 or lookback > bar_index
        [SIGNAL_NEUTRAL, 0.0]
    else
        hi = ta.highest(high, lookback)
        lo = ta.lowest(low, lookback)
        if na(hi) or na(lo) or lo >= hi
            [SIGNAL_NEUTRAL, 0.0]
        else
            range_ = math.max(hi - lo, syminfo.mintick)
            upperBound = hi - (range_ * 0.25)
            lowerBound = lo + (range_ * 0.25)
            totalVol = 0.0
            hiVol = 0.0
            loVol = 0.0
            for i = 0 to lookback - 1
                barVol = math.max(volume[i], 0.0)
                totalVol += barVol
                if high[i] >= upperBound
                    hiVol += barVol
                if low[i] <= lowerBound
                    loVol += barVol
            if totalVol <= 0.0
                [SIGNAL_NEUTRAL, 0.5]
            else
                hiRatio = hiVol / totalVol
                loRatio = loVol / totalVol
                if hiRatio > 0.3 and hiRatio > loRatio
                    [SIGNAL_STRONG_BULL, hiRatio]
                else if loRatio > 0.3 and loRatio > hiRatio
                    [SIGNAL_STRONG_BEAR, loRatio]
                else
                    [SIGNAL_NEUTRAL, 0.5]

// MTF CONFLUENCE (3x TF: 1m, 5m, 15m)
f_mtf_dom_confluence(int lb1m, int lb5m, int lb15m) =>
    [s1, c1] = f_mtf_dom_single_tf(math.min(lb1m, bar_index))
    [s5, c5] = f_mtf_dom_single_tf(math.min(lb5m, bar_index))
    [s15, c15] = f_mtf_dom_single_tf(math.min(lb15m, bar_index))
    bullCount = (s1 > 0.2 ? 1 : 0) + (s5 > 0.2 ? 1 : 0) + (s15 > 0.2 ? 1 : 0)
    bearCount = (s1 < -0.2 ? 1 : 0) + (s5 < -0.2 ? 1 : 0) + (s15 < -0.2 ? 1 : 0)
    avgConfidence = (c1 + c5 + c15) / 3.0
    if bullCount >= 2
        [SIGNAL_STRONG_BULL, avgConfidence]
    else if bearCount >= 2
        [SIGNAL_STRONG_BEAR, avgConfidence]
    else if bullCount == 1
        [SIGNAL_BULL, avgConfidence * 0.7]
    else if bearCount == 1
        [SIGNAL_BEAR, avgConfidence * 0.7]
    else
        [SIGNAL_NEUTRAL, avgConfidence * 0.5]

// STATE MACHINE: BAR COLOR + MTF + DELTA → TREND STATE
f_determine_trend_state(float barColorRaw, float mtfSignal, float deltaColor) =>
    isGreenBar = barColorRaw > 0.5
    isBlackBar = math.abs(barColorRaw) < 0.1
    isRedBar = barColorRaw < -0.5
    
    isMtfBull = mtfSignal > 0.2
    isMtfBear = mtfSignal < -0.2
    isMtfNeutral = math.abs(mtfSignal) <= 0.2
    
    isDeltaGreen = deltaColor > 0.5
    isDeltaRed = deltaColor < -0.5
    isDeltaBlack = math.abs(deltaColor) < 0.1
    
    // SIDEWAYS: BLACK BAR ALWAYS
    if isBlackBar
        [STATE_SIDEWAYS, color.gray, 0.0]
    // BULL SETUP: GREEN BAR + MTF BULL/NEUTRAL + DELTA GREEN/BLACK
    else if isGreenBar and (isMtfBull or isMtfNeutral) and (isDeltaGreen or isDeltaBlack)
        // Refinement: STRONG_BULL if delta green, ACCUM if delta black
        if isDeltaGreen
            [STATE_STRONG_BUY, color.new(color.green, 0), 1.0]
        else
            [STATE_ACCUMULATION, color.new(color.lime, 30), 0.5]
    // BEAR SETUP: RED BAR + MTF BEAR/NEUTRAL + DELTA RED/BLACK
    else if isRedBar and (isMtfBear or isMtfNeutral) and (isDeltaRed or isDeltaBlack)
        // Refinement: STRONG_SELL if delta red, DISTRIB if delta black
        if isDeltaRed
            [STATE_STRONG_SELL, color.new(color.red, 0), -1.0]
        else
            [STATE_DISTRIBUTION, color.new(color.maroon, 30), -0.5]
    // DEFAULT: SIDEWAYS (catch-all, no exceptions)
    else
        [STATE_SIDEWAYS, color.gray, 0.0]

// BAR COLOR DETERMINATION (close vs open)
f_bar_color_state() =>
    if close > open
        1.0  // GREEN
    else if close < open
        -1.0  // RED
    else
        0.0  // BLACK (doji/equal)

// CALCULATE STATE EACH BAR
[tSessionDelta, tSessionHigh, tSessionLow, tBarsInSession] = f_session_delta_accumulate()
sessionDelta := tSessionDelta
sessionHigh := tSessionHigh
sessionLow := tSessionLow
barsInSession := tBarsInSession

deltaLineColor := f_delta_line_color()

mtfLb = math.min(mtfLookback, bar_index)
[tMtfSignal, tMtfConfidence] = f_mtf_dom_confluence(mtfLb, mtfLb * 5, mtfLb * 15)
mtfDomSignal := tMtfSignal
mtfConfidence := tMtfConfidence

barColorState = f_bar_color_state()
[newState, newColor, stateStrength] = f_determine_trend_state(barColorState, mtfDomSignal, deltaLineColor)
trendState := newState
trendColor := newColor

// DISPLAY STATE BOX
if barstate.islast
    if na(stateBox)
        stateBox := table.new(position.bottom_left, 1, 3, border_width=2, border_color=color.gray)
    else
        table.clear(stateBox, 0, 0, 0, 2)
    
    if showState
        mtfStr = switch mtfDomSignal
            SIGNAL_STRONG_BULL => "MTF: STRONG BULL"
            SIGNAL_BULL => "MTF: BULL"
            SIGNAL_NEUTRAL => "MTF: NEUTRAL"
            SIGNAL_BEAR => "MTF: BEAR"
            SIGNAL_STRONG_BEAR => "MTF: STRONG BEAR"
            => "MTF: UNKNOWN"
        
        deltaStr = switch deltaLineColor
            DELTA_GREEN => "DELTA: GREEN"
            DELTA_BLACK => "DELTA: BLACK"
            DELTA_RED => "DELTA: RED"
            => "DELTA: UNKNOWN"
        
        barStr = switch barColorState
            1.0 => "BAR: GREEN"
            -1.0 => "BAR: RED"
            => "BAR: BLACK"
        
        table.cell(stateBox, 0, 0, trendState, bgcolor=trendColor, text_color=color.white, text_size=size.huge, text_halign=text.align_center)
        table.cell(stateBox, 0, 1, barStr + " | " + mtfStr + " | " + deltaStr, bgcolor=color.new(color.navy, 70), text_color=color.white, text_size=size.tiny)

// THRESHOLDS FOR REFERENCE
hline(0.5, "Bull Zone", color=color.new(color.green, 50), linestyle=hline.style_dashed)
hline(-0.5, "Bear Zone", color=color.new(color.red, 50), linestyle=hline.style_dashed)
hline(0, "Neutral", color=color.gray, linestyle=hline.style_dotted)

// EXPORT STATE FOR ALERTS/ORDERS
plot(stateStrength, title="State Strength", color=trendColor, linewidth=2)
