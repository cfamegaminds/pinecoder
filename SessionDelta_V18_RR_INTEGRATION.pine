//@version=6
indicator("SessionDelta Trend Tracker [3:30] V18.1 RR CONFLUENCE", overlay=false, max_lines_count=50, max_boxes_count=50, max_labels_count=500, max_bars_back=5000)

// ════════════════════════════════════════════════════════
// CONSTANTS
// ════════════════════════════════════════════════════════
DAILY_MINUTES = 1440
SESSION_MINUTES = 7200
MAX_DELTA = 9999999.0
MIN_VAL_VAH_CONCENTRATION = 0.65

// ════════════════════════════════════════════════════════
// INPUTS: CORE SESSIONDELTA
// ════════════════════════════════════════════════════════
string sessionTZ = "Asia/Kolkata"
sessHour = input.int(3, "Session Start Hour", minval=0, maxval=23, group="Session")
sessMinute = input.int(30, "Session Start Minute", minval=0, maxval=59, group="Session")

rows = input.int(20, "Profile Rows", minval=10, maxval=50, group="FRVP")
profilesToShow = input.int(20, "Profiles To Plot", minval=1, maxval=30, group="FRVP")

bool showDeltaSpikes = input.bool(true, "Show Delta Spikes", group="OFD7")
bool showDivergence = input.bool(true, "Show Bearish Divergence", group="OFD7")
float bearishDivLevel = input.float(2500, "Bearish Divergence Level", group="OFD7")
float spikeDeltaBand = input.float(5000, "Delta Spike: Max |Δ|", minval=0, group="OFD7")

float wBuySideLiq = input.float(3.0, "Weight: Buyside Liquidity", minval=0, group="Liquidity")
float wSellSideLiq = input.float(3.0, "Weight: Sellside Liquidity", minval=0, group="Liquidity")

// ════════════════════════════════════════════════════════
// INPUTS: RISK/REWARD [NEW]
// ════════════════════════════════════════════════════════
bool showRiskReward     = input.bool(true, "Show Risk/Reward Panel", group = "Risk Management")
float accountSize       = input.float(10000, "Account Size ($)", minval = 100, group = "Risk Management")
float riskPercent       = input.float(1.0, "Risk Per Trade %", minval = 0.1, maxval = 5.0, step = 0.1, group = "Risk Management")
float rewardMultiplier  = input.float(3.0, "Reward Multiplier (1:X)", minval = 1.0, maxval = 10.0, step = 0.5, group = "Risk Management")

// ════════════════════════════════════════════════════════
// ANCHOR ENGINE (1m MTF session)
// ════════════════════════════════════════════════════════
f_session() =>
    _new = hour(time, 'Asia/Kolkata') == 3 and minute(time, 'Asia/Kolkata') == 30
    var float _cH   = na
    var float _cL   = na
    var float _pH   = na
    var float _pL   = na
    var float _anch = na
    var float _oteH = na
    var float _oteL = na
    if _new
        _pH   := _cH
        _pL   := _cL
        _cH   := high
        _cL   := low
        _anch := open
        if not na(_pH)
            _r    = _pH - _pL
            _oteH := _pH - _r * 0.79
            _oteL := _pH - _r * 0.90
    else
        _cH := na(_cH) ? high : math.max(_cH, high)
        _cL := na(_cL) ? low  : math.min(_cL, low)
    [_anch, _oteH, _oteL]

[_anch, _oteH, _oteL] = request.security(syminfo.tickerid, '1', f_session(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

var float anchor = na
anchor := nz(_anch, anchor[1])

// ════════════════════════════════════════════════════════
// STATE VARIABLES: CORE
// ════════════════════════════════════════════════════════
var int[] sessionStarts = array.new_int()
var int[] sessionEnds = array.new_int()
var bool sessionJustClosed = false
var float sessionDelta = 0.0
var float lockedSessionVAL = na
var float lockedSessionVAH = na
var bool sessionLocked = false
var float sessionHigh = na
var float sessionLow = na
var int barsInSession = 0
var table liqTable = table.new(position.top_right, 2, 3, border_width=1, frame_width=1, frame_color=color.white)
var table biasBox = table.new(position.bottom_left, 1, 3, border_width=1, border_color=color.gray)
var string headerText = ""
var string line1Text = ""
var string line2Text = ""
var color hdrColor = color.gray
var color l1Color = color.gray
var color l2Color = color.gray
var float sessionVALVAHConcentration = 1.0
var bool valvahStrong = true

// ════════════════════════════════════════════════════════
// STATE VARIABLES: RISK/REWARD [NEW]
// ════════════════════════════════════════════════════════
var float entryPrice    = na
var float stopLoss      = na
var float takeProfit    = na
var float positionRisk  = na
var float positionReward = na
var string rrSignal     = ""
var table rrTable       = na

// ════════════════════════════════════════════════════════
// POC CALCULATION
// ════════════════════════════════════════════════════════
calcPOCFast(float priceHi, float priceLo, int numBins, int lookback) =>
    if na(priceHi) or na(priceLo) or priceLo >= priceHi
        na
    else
        range_ = math.max(priceHi - priceLo, syminfo.mintick)
        step = range_ / numBins
        binsVol = array.new_float(numBins, 0.0)
        maxLookback = math.min(lookback - 1, 500)
        for i = 0 to maxLookback
            price = close[i]
            vol = volume[i]
            if price >= priceLo and price <= priceHi
                idx = math.max(0, math.min(numBins - 1, math.floor((price - priceLo) / step)))
                array.set(binsVol, idx, array.get(binsVol, idx) + vol)
        maxVol = array.max(binsVol)
        pocIdx = array.indexof(binsVol, maxVol)
        pocIdx >= 0 ? priceLo + step * pocIdx + step * 0.5 : na

// ════════════════════════════════════════════════════════
// PROFILE CALCULATION WITH NaN ISOLATION
// ════════════════════════════════════════════════════════
calcProfileLevels(_startBar, _endBar, _rows) =>
    lookback = math.max(1, math.min(_endBar - _startBar + 1, 500))
    hi = ta.highest(high, lookback)
    lo = ta.lowest(low, lookback)
    if na(hi) or na(lo) or lo >= hi
        [na, na, na]
    else
        myRange = math.max(hi - lo, syminfo.mintick)
        step = myRange / _rows
        volumeRows = array.new_float(_rows, 0.0)
        totalVol = 0.0
        for i = 0 to lookback - 1
            barHigh = high[i]
            barLow = low[i]
            barVol = volume[i]
            totalVol += barVol
            barRange = math.max(barHigh - barLow, syminfo.mintick)
            for r = 0 to _rows - 1
                rowLow = lo + step * r
                rowHigh = rowLow + step
                overlap = math.max(math.min(barHigh, rowHigh) - math.max(barLow, rowLow), 0)
                if overlap > 0
                    array.set(volumeRows, r, array.get(volumeRows, r) + barVol * (overlap / barRange))
        maxVol = 0.0
        pocRow = 0
        for r = 0 to _rows - 1
            rowVol = array.get(volumeRows, r)
            if rowVol > maxVol
                maxVol := rowVol
                pocRow := r
        poc = lo + step * pocRow + step * 0.5
        if totalVol <= 0
            [poc, lo + step * _rows, lo]
        else
            targetVol = totalVol * 0.79
            valueVol = maxVol
            vahRow = pocRow
            valRow = pocRow
            upRow = pocRow + 1
            downRow = pocRow - 1
            while valueVol < targetVol and (upRow < _rows or downRow >= 0)
                volUp = upRow < _rows and upRow >= 0 ? array.get(volumeRows, upRow) : 0.0
                volDown = downRow >= 0 and downRow < _rows ? array.get(volumeRows, downRow) : 0.0
                if volUp > volDown
                    if upRow < _rows
                        valueVol += volUp
                        vahRow := upRow
                        upRow += 1
                    else if downRow >= 0
                        valueVol += volDown
                        valRow := downRow
                        downRow -= 1
                else if volDown > volUp
                    if downRow >= 0
                        valueVol += volDown
                        valRow := downRow
                        downRow -= 1
                    else if upRow < _rows
                        valueVol += volUp
                        vahRow := upRow
                        upRow += 1
                else
                    if upRow < _rows
                        valueVol += volUp
                        vahRow := upRow
                        upRow += 1
                    else if downRow >= 0
                        valueVol += volDown
                        valRow := downRow
                        downRow -= 1
            vahRow := math.max(0, math.min(_rows - 1, vahRow))
            valRow := math.max(0, math.min(_rows - 1, valRow))
            vah = lo + step * vahRow + step
            val = lo + step * valRow
            [poc, vah, val]

// ════════════════════════════════════════════════════════
// SESSION TRACKING
// ════════════════════════════════════════════════════════
curHour = hour(time, sessionTZ)
curMin = minute(time, sessionTZ)
isNewSession = (curHour == sessHour and curMin == sessMinute)

if isNewSession
    if array.size(sessionStarts) > array.size(sessionEnds)
        array.push(sessionEnds, bar_index - 1)
    array.push(sessionStarts, bar_index)
    sessionJustClosed := true
    barsInSession := 1
    while array.size(sessionStarts) > profilesToShow + 1
        array.shift(sessionStarts)
    while array.size(sessionEnds) > profilesToShow
        array.shift(sessionEnds)
else
    sessionJustClosed := false
    barsInSession += 1

// ════════════════════════════════════════════════════════
// LIQUIDITY LOCK WITH STRENGTH CHECK
// ════════════════════════════════════════════════════════
if sessionJustClosed and array.size(sessionEnds) > 0
    latestSessionEnd = array.get(sessionEnds, array.size(sessionEnds) - 1)
    if not na(latestSessionEnd) and array.size(sessionStarts) >= 2
        latestSessionStart = array.get(sessionStarts, array.size(sessionStarts) - 2)
        [tmpPOC, tmpVAH, tmpVAL] = calcProfileLevels(latestSessionStart, latestSessionEnd, rows)
        if not na(tmpVAH) and not na(tmpVAL)
            valvahRange = tmpVAH - tmpVAL
            if valvahRange > 0
                sessionVolTot = 0.0
                valvahVol = 0.0
                lookbackRange = math.min(latestSessionEnd - latestSessionStart + 1, 500)
                for i = 0 to lookbackRange - 1
                    sessionVolTot += volume[i]
                    barPrice = close[i]
                    if barPrice >= tmpVAL and barPrice <= tmpVAH
                        valvahVol += volume[i]
                sessionVALVAHConcentration := sessionVolTot > 0 ? valvahVol / sessionVolTot : 0.0
                valvahStrong := sessionVALVAHConcentration >= MIN_VAL_VAH_CONCENTRATION
            lockedSessionVAL := tmpVAL
            lockedSessionVAH := tmpVAH
            sessionLocked := true

float buySideLiquidity = sessionLocked ? lockedSessionVAL : close
float sellSideLiquidity = sessionLocked ? lockedSessionVAH : close

// ════════════════════════════════════════════════════════
// DELTA TRACKING + OVERFLOW GUARD
// ════════════════════════════════════════════════════════
isUp = close > open
isDown = close < open
buyVolume = isUp ? volume : 0.0
sellVolume = isDown ? volume : 0.0
delta = buyVolume - sellVolume

if isNewSession
    sessionDelta := delta
else
    newSessionDelta = sessionDelta + delta
    sessionDelta := math.min(math.max(newSessionDelta, -MAX_DELTA), MAX_DELTA)

// ════════════════════════════════════════════════════════
// SESSION EXTREMES
// ════════════════════════════════════════════════════════
if isNewSession
    sessionHigh := high
    sessionLow := low
else
    if na(sessionHigh)
        sessionHigh := high
    else
        sessionHigh := math.max(sessionHigh, high)
    if na(sessionLow)
        sessionLow := low
    else
        sessionLow := math.min(sessionLow, low)

// ════════════════════════════════════════════════════════
// VOLATILITY-NORMALIZED DELTA SPIKE
// ════════════════════════════════════════════════════════
absDelta = math.abs(delta)
atr20 = ta.atr(20)
atrScaled = math.max(atr20 * volume / ta.sma(volume, 20), syminfo.mintick)
volNormThreshold = ta.wma(absDelta, 20) * 2.5 + atrScaled * 0.05
deltaSpike = absDelta > volNormThreshold

// ════════════════════════════════════════════════════════
// DELTA SPIKE DIRECTION FILTER
// ════════════════════════════════════════════════════════
deltaTrend = ta.wma(sessionDelta, 5)
deltaTrendUp = deltaTrend > deltaTrend[1]
deltaTrendDown = deltaTrend < deltaTrend[1]
spikeSameDirection = (delta > 0 and deltaTrendUp) or (delta < 0 and deltaTrendDown)

// ════════════════════════════════════════════════════════
// DIVERGENCE WITH 2-BAR CONFIRMATION
// ════════════════════════════════════════════════════════
priceNewHigh = high > sessionHigh
deltaBelowDiv = sessionDelta < bearishDivLevel
highFor2Bars = priceNewHigh and high[1] >= sessionHigh[1]
deltaNoteUp = sessionDelta < sessionDelta[1]
bearishDiv = (priceNewHigh or highFor2Bars) and deltaBelowDiv and close < sessionHigh and deltaNoteUp

// ════════════════════════════════════════════════════════
// LIQUIDITY ZONE ELASTICITY
// ════════════════════════════════════════════════════════
barsSinceLock = barsInSession
valTouched = ta.lowest(low, math.min(barsSinceLock, 20)) <= lockedSessionVAL
vahTouched = ta.highest(high, math.min(barsSinceLock, 20)) >= lockedSessionVAH
expansion = valTouched and vahTouched ? 1.0 : 1.15
elasticVAL = lockedSessionVAL - (lockedSessionVAH - lockedSessionVAL) * (expansion - 1.0) * 0.5
elasticVAH = lockedSessionVAH + (lockedSessionVAH - lockedSessionVAL) * (expansion - 1.0) * 0.5

float buySideLiquidityAdapt = sessionLocked ? elasticVAL : buySideLiquidity
float sellSideLiquidityAdapt = sessionLocked ? elasticVAH : sellSideLiquidity

// ════════════════════════════════════════════════════════
// ANCHOR-GATED COLOR LOGIC [PRODUCTION]
// ════════════════════════════════════════════════════════
color deltaColor = color.black

if close > sellSideLiquidityAdapt and close > anchor and sessionDelta > 0
    deltaColor := color.new(color.green, 0)
else if close < buySideLiquidityAdapt and close < anchor and sessionDelta < 0
    deltaColor := color.new(color.red, 0)

plot(sessionDelta, title='Session Cumulative Delta', color=deltaColor, linewidth=3)
hline(0, 'Zero Line', color=color.black, linewidth=2)

// ════════════════════════════════════════════════════════
// RISK/REWARD: SIGNAL DETECTION [NEW]
// ════════════════════════════════════════════════════════
isBullish = close > sellSideLiquidityAdapt and close > anchor and sessionDelta > 0
isBearish = close < buySideLiquidityAdapt and close < anchor and sessionDelta < 0

bullishSignal = isBullish and (deltaSpike or bearishDiv)
bearishSignal = isBearish and (deltaSpike or bearishDiv)

// ════════════════════════════════════════════════════════
// RISK/REWARD: CALCULATION FUNCTIONS [NEW]
// ════════════════════════════════════════════════════════
f_calculateLongRR() =>
    riskAmount = accountSize * (riskPercent / 100.0)
    if not na(buySideLiquidityAdapt) and not na(elasticVAL) and buySideLiquidityAdapt > elasticVAL
        entry = buySideLiquidityAdapt
        sl = elasticVAL - syminfo.mintick
        distance = entry - sl
        if distance > 0
            tp = entry + (distance * rewardMultiplier)
            [entry, sl, tp, riskAmount, distance * rewardMultiplier]
        else
            [na, na, na, na, na]
    else
        [na, na, na, na, na]

f_calculateShortRR() =>
    riskAmount = accountSize * (riskPercent / 100.0)
    if not na(sellSideLiquidityAdapt) and not na(elasticVAH) and sellSideLiquidityAdapt < elasticVAH
        entry = sellSideLiquidityAdapt
        sl = elasticVAH + syminfo.mintick
        distance = sl - entry
        if distance > 0
            tp = entry - (distance * rewardMultiplier)
            [entry, sl, tp, riskAmount, distance * rewardMultiplier]
        else
            [na, na, na, na, na]
    else
        [na, na, na, na, na]

// ════════════════════════════════════════════════════════
// RISK/REWARD: STATE UPDATE [NEW]
// ════════════════════════════════════════════════════════
if bullishSignal and bullishSetupConfirmed := true
    [entry, sl, tp, risk, reward] = f_calculateLongRR()
    entryPrice   := entry
    stopLoss     := sl
    takeProfit   := tp
    positionRisk := risk
    positionReward := reward
    rrSignal     := "LONG"
else if bearishSignal and bearishSetupConfirmed := true
    [entry, sl, tp, risk, reward] = f_calculateShortRR()
    entryPrice   := entry
    stopLoss     := sl
    takeProfit   := tp
    positionRisk := risk
    positionReward := reward
    rrSignal     := "SHORT"
else
    entryPrice   := na
    stopLoss     := na
    takeProfit   := na
    positionRisk := na
    positionReward := na
    rrSignal     := ""

// Dummies for logic flow (remove after test)
bullishSetupConfirmed = true
bearishSetupConfirmed = true

// ════════════════════════════════════════════════════════
// LIQUIDITY TABLE
// ════════════════════════════════════════════════════════
if barstate.islast
    table.cell(liqTable, 0, 0, text="Liquidity Level", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(liqTable, 1, 0, text="Price", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(liqTable, 0, 1, text="Buyside", bgcolor=color.new(color.green, 90), text_color=color.white, text_size=size.small)
    table.cell(liqTable, 1, 1, text=str.tostring(buySideLiquidityAdapt, format.mintick), bgcolor=color.new(color.green, 95), text_color=color.white, text_size=size.small)
    table.cell(liqTable, 0, 2, text="Sellside", bgcolor=color.new(color.red, 90), text_color=color.white, text_size=size.small)
    table.cell(liqTable, 1, 2, text=str.tostring(sellSideLiquidityAdapt, format.mintick), bgcolor=color.new(color.red, 95), text_color=color.white, text_size=size.small)

// ════════════════════════════════════════════════════════
// ANCHOR-GATED BIAS LOGIC [PRODUCTION]
// ════════════════════════════════════════════════════════
bool isBullishBias = close > sellSideLiquidityAdapt and close > anchor and sessionDelta > 0
bool isBearishBias = close < buySideLiquidityAdapt and close < anchor and sessionDelta < 0
bool isBalanced = not isBullishBias and not isBearishBias

if isBullishBias
    headerText := "✔ BULLISH BIAS"
    line1Text := "CMP > SellLiQ | CMP > Anchor | Δ GREEN [BUY]"
    line2Text := str.tostring(sessionDelta, "#,##0.00")
    hdrColor := color.new(color.green, 10)
    l1Color := color.new(color.green, 20)
    l2Color := color.new(color.green, 50)
else if isBearishBias
    headerText := "⚠ BEARISH BIAS"
    line1Text := "CMP < BuyLiQ | CMP < Anchor | Δ RED [SELL]"
    line2Text := str.tostring(sessionDelta, "#,##0.00")
    hdrColor := color.new(color.red, 10)
    l1Color := color.new(color.red, 20)
    l2Color := color.new(color.red, 50)
else
    headerText := "◆ BALANCED"
    line1Text := "Δ BLACK | Anchor Filter Active [⚠ NO TRADE]"
    line2Text := str.tostring(sessionDelta, "#,##0.00")
    hdrColor := color.new(color.orange, 10)
    l1Color := color.new(color.black, 10)
    l2Color := color.new(color.gray, 20)

if barstate.islast
    table.cell(biasBox, 0, 0, headerText, bgcolor=hdrColor, text_color=color.white, text_size=size.large)
    table.cell(biasBox, 0, 1, line1Text, bgcolor=l1Color, text_color=color.white, text_size=size.large)
    table.cell(biasBox, 0, 2, line2Text, bgcolor=l2Color, text_color=color.white, text_size=size.large)

// ════════════════════════════════════════════════════════
// DIVERGENCE & SPIKE PLOTS
// ════════════════════════════════════════════════════════
plot(showDivergence and bearishDiv and valvahStrong ? sessionDelta : na, title='Bearish Divergence Signal', color=color.new(color.red, 0), linewidth=6, style=plot.style_circles)

inDeltaBand = math.abs(sessionDelta) <= spikeDeltaBand
plot(showDeltaSpikes and deltaSpike and inDeltaBand and spikeSameDirection ? sessionDelta : na, title='Delta Spike', color=color.black, linewidth=5, style=plot.style_circles)

// ════════════════════════════════════════════════════════
// RISK/REWARD TABLE [NEW]
// ════════════════════════════════════════════════════════
if barstate.islast and showRiskReward
    if na(rrTable)
        rrTable := table.new(position.bottom_right, 2, 5, border_width=1, frame_width=1, frame_color=color.white)
    
    rrColor = rrSignal == "LONG" ? color.new(color.green, 25) : rrSignal == "SHORT" ? color.new(color.red, 25) : color.new(color.gray, 80)
    table.cell(rrTable, 0, 0, text="R/R SIGNAL", bgcolor=rrColor, text_color=color.white, text_size=size.large, text_halign=text.align_center)
    table.cell(rrTable, 1, 0, text=rrSignal, bgcolor=rrColor, text_color=color.white, text_size=size.large, text_halign=text.align_center)
    
    table.cell(rrTable, 0, 1, text="Entry", bgcolor=color.new(color.blue, 90), text_color=color.white, text_size=size.small)
    table.cell(rrTable, 1, 1, text=na(entryPrice) ? "—" : str.tostring(entryPrice, format.mintick), bgcolor=color.new(color.blue, 95), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    table.cell(rrTable, 0, 2, text="Stop Loss", bgcolor=color.new(color.red, 90), text_color=color.white, text_size=size.small)
    table.cell(rrTable, 1, 2, text=na(stopLoss) ? "—" : str.tostring(stopLoss, format.mintick), bgcolor=color.new(color.red, 95), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    table.cell(rrTable, 0, 3, text="Take Profit", bgcolor=color.new(color.green, 90), text_color=color.white, text_size=size.small)
    table.cell(rrTable, 1, 3, text=na(takeProfit) ? "—" : str.tostring(takeProfit, format.mintick), bgcolor=color.new(color.green, 95), text_color=color.white, text_size=size.small, text_halign=text.align_right)
    
    riskRewardRatio = na(positionRisk) or positionRisk == 0 ? na : positionReward / positionRisk
    rrRatioStr = na(riskRewardRatio) ? "—" : str.tostring(riskRewardRatio, "#.##")
    table.cell(rrTable, 0, 4, text="Risk:Reward", bgcolor=color.new(color.orange, 90), text_color=color.white, text_size=size.small)
    table.cell(rrTable, 1, 4, text="1:" + rrRatioStr, bgcolor=color.new(color.orange, 95), text_color=color.white, text_size=size.small, text_halign=text.align_right)
