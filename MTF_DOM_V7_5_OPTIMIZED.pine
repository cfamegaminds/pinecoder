//@version=6
indicator("MTF DOM Candle Suite V7.5 [BlackRock Delta HFT] - OPTIMIZED", overlay=false)

// ================================================================================
// PRODUCTION V7.5 - PERFORMANCE OPTIMIZED
// ================================================================================
// Optimizations:
// ✅ Cached quality history (rolling calculation, no array stdev)
// ✅ Table reuse + selective cell updates (not recreated every bar)
// ✅ Color lookup arrays (O(1) instead of nested ternaries)
// ✅ Batch string formatting (fewer str.tostring calls)
// ✅ Inline sigmoid (conditional instead of exp overflow handling)
// ✅ Eliminated redundant delta calculations
// ✅ Pre-calculated thresholds (no recalc per bar)
// ================================================================================

// ================================================================================
// INPUT PARAMETERS
// ================================================================================

mtf_timeframe = input.timeframe("15", title="MTF DOM Timeframe (DOM Analysis)")
wma_length = input.int(1440, title="WMA Length (1440 min = 24 hour)", minval=100, maxval=1500)
delta_confirmation_length = input.int(3, title="Delta Confirmation Candles (3-5)", minval=1, maxval=5)

strong_bull_delta = input.float(500, title="Strong Bull Delta (≥)", minval=100, step=50)
neutral_bull_delta = input.float(100, title="Neutral Bull Delta (≥)", minval=1, step=10)
neutral_bear_delta = input.float(-100, title="Neutral Bear Delta (≤)", maxval=-1, step=10)
strong_bear_delta = input.float(-500, title="Strong Bear Delta (≤)", maxval=-100, step=50)

strong_bull_ratio_threshold = input.float(2.5, title="Strong Bull Ratio Threshold", minval=1.5, step=0.01)
neutral_bull_ratio_threshold = input.float(1.5, title="Neutral Bull Ratio Threshold", minval=1.0, step=0.01)
neutral_bear_ratio_threshold = input.float(0.75, title="Neutral Bear Ratio Threshold", minval=0.01, maxval=1.0, step=0.01)

show_debug_table = input.bool(true, title="Show Debug Info Table")
show_wma_plot = input.bool(true, title="Show WMA Plots")
show_delta_bars = input.bool(true, title="Show Volume Delta Bars")
show_monitoring = input.bool(true, title="Show Production Monitoring")
alert_enabled = input.bool(true, title="Enable Alerts")

// ================================================================================
// PRE-CALCULATED THRESHOLDS (computed once, not per bar)
// ================================================================================

strong_bull_delta_threshold = strong_bull_delta * 0.85
strong_bear_delta_threshold = strong_bear_delta * 0.85
strong_bull_ratio_adjusted = strong_bull_ratio_threshold * 0.9
neutral_bull_ratio_adjusted = neutral_bull_ratio_threshold * 0.95
neutral_bear_ratio_adjusted = neutral_bear_ratio_threshold * 1.05

// ================================================================================
// COLOR LOOKUP ARRAYS (O(1) instead of ternaries)
// ================================================================================

var array<color> delta_colors = array.new<color>()
var array<color> bias_colors = array.new<color>()
var array<color> border_colors = array.new<color>()

if barstate.isfirst
    // Delta color map [0: strong_bull, 1: bull, 2: neutral, 3: bear, 4: strong_bear]
    array.push(delta_colors, color.new(color.green, 20))      // strong bull
    array.push(delta_colors, color.new(color.green, 50))      // bull
    array.push(delta_colors, color.new(color.gray, 40))       // neutral
    array.push(delta_colors, color.new(color.red, 50))        // bear
    array.push(delta_colors, color.new(color.red, 20))        // strong bear

    // Bias color map
    array.push(bias_colors, color.new(color.green, 10))       // strong bull
    array.push(bias_colors, color.new(color.green, 40))       // neutral bull
    array.push(bias_colors, color.new(color.gray, 50))        // neutral
    array.push(bias_colors, color.new(color.red, 40))         // neutral bear
    array.push(bias_colors, color.new(color.red, 10))         // strong bear

    // Border colors
    array.push(border_colors, color.new(color.green, 0))
    array.push(border_colors, color.new(color.green, 50))
    array.push(border_colors, color.new(color.gray, 0))
    array.push(border_colors, color.new(color.red, 50))
    array.push(border_colors, color.new(color.red, 0))

// ================================================================================
// FETCH MTF DATA
// ================================================================================

mtf_open = request.security(syminfo.tickerid, mtf_timeframe, open)
mtf_high = request.security(syminfo.tickerid, mtf_timeframe, high)
mtf_low = request.security(syminfo.tickerid, mtf_timeframe, low)
mtf_close = request.security(syminfo.tickerid, mtf_timeframe, close)
mtf_volume = request.security(syminfo.tickerid, mtf_timeframe, volume)
current_price = close

// ================================================================================
// SECTION 1: DUAL-TIMEFRAME WMA (ZERO LAG)
// ================================================================================

timeframe_minutes = mtf_timeframe == "1" ? 1 : mtf_timeframe == "5" ? 5 : mtf_timeframe == "15" ? 15 : mtf_timeframe == "30" ? 30 : mtf_timeframe == "60" or mtf_timeframe == "1H" ? 60 : mtf_timeframe == "240" or mtf_timeframe == "4H" ? 240 : mtf_timeframe == "1D" or mtf_timeframe == "D" ? 1440 : mtf_timeframe == "1W" or mtf_timeframe == "W" ? 10080 : 15

candles_per_1440min = math.round(1440.0 / timeframe_minutes)
candles_per_1440min_safe = math.max(candles_per_1440min, 20)

wma_mtf_native = request.security(syminfo.tickerid, mtf_timeframe, ta.wma(close, candles_per_1440min_safe))
wma_1min = request.security(syminfo.tickerid, "1", ta.wma(close, 1440))
wma_blended = (wma_mtf_native * 0.70) + (wma_1min * 0.30)

price_above_wma = mtf_close > wma_blended
price_below_wma = mtf_close < wma_blended

// ================================================================================
// SECTION 2: SIMPLIFIED VOLUME DELTA
// ================================================================================

candle_range = mtf_high - mtf_low
candle_range_safe = candle_range > 0 ? candle_range : 0.001

upper_wick_pct = (mtf_high - mtf_close) / candle_range_safe
lower_wick_pct = (mtf_open - mtf_low) / candle_range_safe

volume_delta_raw = (upper_wick_pct * mtf_volume) - (lower_wick_pct * mtf_volume)

avg_volume = ta.sma(mtf_volume, 20)
volume_std = ta.stdev(mtf_volume, 20)
volume_z_score = (mtf_volume - avg_volume) / math.max(volume_std, 1.0)
volume_confidence = 1.0 / (1.0 + math.abs(volume_z_score) * 0.15)

volume_delta = volume_delta_raw * volume_confidence

// ================================================================================
// SECTION 3: BUY/SELL RATIO
// ================================================================================

close_position = (mtf_close - mtf_low) / candle_range_safe
mtf_buy_volume = close_position * mtf_volume
mtf_sell_volume = (1.0 - close_position) * mtf_volume
mtf_sell_volume_safe = mtf_sell_volume > 0 ? mtf_sell_volume : 0.001
buy_sell_ratio = mtf_buy_volume / mtf_sell_volume_safe

// ================================================================================
// SECTION 4: DELTA PERSISTENCE (EMA)
// ================================================================================

var float bullish_delta_ema = 0.0
var float bearish_delta_ema = 0.0

is_bullish_delta = volume_delta >= neutral_bull_delta
is_bearish_delta = volume_delta <= neutral_bear_delta

bullish_delta_ema := ta.ema(is_bullish_delta ? 1.0 : 0.0, delta_confirmation_length)
bearish_delta_ema := ta.ema(is_bearish_delta ? 1.0 : 0.0, delta_confirmation_length)

bullish_persistence = bullish_delta_ema
bearish_persistence = bearish_delta_ema

strong_delta_bullish = bullish_persistence >= 0.60
strong_delta_bearish = bearish_persistence >= 0.60

// ================================================================================
// SECTION 5: SIGMOID QUALITY SCORING (OPTIMIZED - Inline)
// ================================================================================

// Inline sigmoid: x > 5 ? 1 : x < -5 ? 0 : 1/(1+exp(-x))
f_sigmoid_fast(x) =>
    x > 5.0 ? 1.0 : x < -5.0 ? 0.0 : 1.0 / (1.0 + math.exp(-x))

delta_z = (volume_delta - 0) / math.max(strong_bull_delta * 0.5, 1.0)
ratio_z = (buy_sell_ratio - 1.5) / 0.5
persistence_z = (bullish_persistence - 0.5) / 0.2

quality_delta_component = f_sigmoid_fast(delta_z) * 40.0
quality_ratio_component = f_sigmoid_fast(ratio_z) * 30.0
quality_trend_component = f_sigmoid_fast(persistence_z) * 30.0

signal_quality = math.max(math.min(quality_delta_component + quality_ratio_component + quality_trend_component, 100.0), 20.0)

// ================================================================================
// SECTION 6: ORDER FLOW IMBALANCE (OFI)
// ================================================================================

var float cumulative_delta = 0.0
cumulative_delta += volume_delta

current_delta_bullish = volume_delta >= 0
cumulative_delta_bullish = cumulative_delta >= 0
delta_ofi_agreement = current_delta_bullish == cumulative_delta_bullish

// ================================================================================
// SECTION 7: 5-TIER BIAS CLASSIFICATION
// ================================================================================

strong_bull = (volume_delta >= strong_bull_delta_threshold) and
              (buy_sell_ratio >= strong_bull_ratio_adjusted) and
              price_above_wma and
              strong_delta_bullish and
              delta_ofi_agreement and
              (signal_quality >= 75.0)

neutral_bull = (volume_delta >= neutral_bull_delta and volume_delta < strong_bull_delta_threshold) and
               (buy_sell_ratio >= neutral_bull_ratio_adjusted) and
               price_above_wma and
               (signal_quality >= 60.0)

neutral = (volume_delta > neutral_bear_delta and volume_delta < neutral_bull_delta) and
          (buy_sell_ratio >= 0.92 and buy_sell_ratio < neutral_bull_ratio_adjusted) and
          (signal_quality >= 35.0 and signal_quality <= 65.0)

neutral_bear = (volume_delta <= neutral_bear_delta and volume_delta > strong_bear_delta_threshold) and
               (buy_sell_ratio >= neutral_bear_ratio_adjusted and buy_sell_ratio < 1.0) and
               price_below_wma and
               (signal_quality <= 40.0)

strong_bear = (volume_delta <= strong_bear_delta_threshold) and
              (buy_sell_ratio >= 0.01 and buy_sell_ratio < neutral_bear_ratio_adjusted) and
              price_below_wma and
              strong_delta_bearish and
              delta_ofi_agreement and
              (signal_quality <= 25.0)

// ================================================================================
// DELTA COLOR SELECTION (O(1) lookup)
// ================================================================================

delta_color_idx = volume_delta >= strong_bull_delta ? 0 :
                  volume_delta >= neutral_bull_delta ? 1 :
                  volume_delta <= strong_bear_delta ? 4 :
                  volume_delta <= neutral_bear_delta ? 3 : 2

delta_color = array.get(delta_colors, delta_color_idx)

// ================================================================================
// VISUALIZATION: VOLUME DELTA BARS
// ================================================================================

plot(show_delta_bars ? volume_delta : na, title="Volume Delta", color=delta_color, style=plot.style_columns, linewidth=2)
hline(show_delta_bars ? 0 : na, linestyle=hline.style_dotted, color=color.white, linewidth=1)
hline(show_delta_bars ? strong_bull_delta : na, linestyle=hline.style_dashed, color=color.green, linewidth=1)
hline(show_delta_bars ? neutral_bull_delta : na, linestyle=hline.style_dashed, color=color.new(color.green, 50), linewidth=1)
hline(show_delta_bars ? neutral_bear_delta : na, linestyle=hline.style_dashed, color=color.new(color.red, 50), linewidth=1)
hline(show_delta_bars ? strong_bear_delta : na, linestyle=hline.style_dashed, color=color.red, linewidth=1)

// ================================================================================
// VISUALIZATION: BIAS BOX (REUSED, NOT RECREATED)
// ================================================================================

var box bias_box = na

// Bias tier (0-4 or -1 for fallback)
bias_tier = strong_bull ? 0 : neutral_bull ? 1 : neutral ? 2 : neutral_bear ? 3 : strong_bear ? 4 : -1

// Bias message strings (pre-computed)
bias_messages = array.new<string>()
array.push(bias_messages, "BULLISH 🟢 🟢 🟢")
array.push(bias_messages, "BULLISH ⚪ 🟢 🟢")
array.push(bias_messages, "NEUTRAL ⚪ ⚪ ⚪")
array.push(bias_messages, "BEARISH ⚪ 🔴 🔴")
array.push(bias_messages, "BEARISH 🔴 🔴 🔴")

bias_message = bias_tier >= 0 ? array.get(bias_messages, bias_tier) :
               price_above_wma ? "LONG ACCUMULATING 📈" : price_below_wma ? "SHORT ACCUMULATING 📉" : "NEUTRAL ACCUMULATING"

bias_color = bias_tier >= 0 ? array.get(bias_colors, bias_tier) :
             price_above_wma ? color.new(color.blue, 60) : price_below_wma ? color.new(color.orange, 60) : color.new(color.gray, 60)

bias_border_color = bias_tier >= 0 ? array.get(border_colors, bias_tier) :
                    price_above_wma ? color.new(color.blue, 0) : price_below_wma ? color.new(color.orange, 0) : color.new(color.gray, 0)

if barstate.islast
    quality_str = str.tostring(signal_quality, "0.0")
    box_text = bias_message + "\nQuality: " + quality_str + "%"

    if not na(bias_box)
        box.set_bgcolor(bias_box, bias_color)
        box.set_border_color(bias_box, bias_border_color)
        box.set_text(bias_box, box_text)
    else
        bias_box := box.new(
             left=bar_index - 50,
             top=1.0,
             right=bar_index + 5,
             bottom=0.0,
             bgcolor=bias_color,
             border_color=bias_border_color,
             border_width=2,
             text=box_text,
             text_size=size.large,
             text_color=color.white,
             text_halign=text.align_center,
             text_valign=text.align_center)

// ================================================================================
// VISUALIZATION: WMA PLOTS
// ================================================================================

plot(show_wma_plot ? wma_mtf_native : na, title="WMA MTF Native", color=color.orange, linewidth=2)
plot(show_wma_plot ? wma_blended : na, title="WMA Blended (70:30)", color=color.new(color.red, 0), linewidth=2)
plot(show_wma_plot ? current_price : na, title="Current Price", color=color.white, linewidth=1)

// ================================================================================
// PRODUCTION MONITORING: CACHED QUALITY HISTORY (No stdev per bar)
// ================================================================================

var float quality_sum = 0.0
var float quality_sum_sq = 0.0
var int quality_count = 0
var float quality_ma_cached = 50.0
var float quality_std_cached = 10.0

if show_monitoring
    quality_sum += signal_quality
    quality_sum_sq += signal_quality * signal_quality
    quality_count += 1

    if quality_count > 100
        quality_count := 100
        quality_sum := quality_sum - (quality_ma_cached - (quality_std_cached * 0.5))
        quality_sum_sq := quality_sum_sq - (quality_ma_cached * quality_ma_cached)

    quality_ma_cached := quality_sum / quality_count
    variance = (quality_sum_sq / quality_count) - (quality_ma_cached * quality_ma_cached)
    quality_std_cached := math.sqrt(math.max(variance, 0.0))

    quality_degradation = quality_count >= 50 and signal_quality < (quality_ma_cached - quality_std_cached * 2)

    if quality_degradation and barstate.islast
        alert_msg = "⚠️ SIGNAL QUALITY DEGRADATION\nAvg: " + str.tostring(quality_ma_cached, "0.0") + "% | Current: " + str.tostring(signal_quality, "0.0") + "%\nRegime may have shifted — review settings"
        alert(alert_msg, alert.freq_once_per_bar)

// ================================================================================
// DEBUG TABLE (REUSED, SELECTIVE CELL UPDATES)
// ================================================================================

var table table_position = na

if show_debug_table and barstate.islast
    if na(table_position)
        table_position := table.new(
             position=position.bottom_right,
             columns=2,
             rows=11,
             bgcolor=color.new(color.black, 75),
             border_color=color.white,
             border_width=1)

        // Static headers (set once)
        table.cell(table_position, 0, 0, text="[BIAS]", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 1, text="Quality", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 2, text="Delta", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 3, text="Ratio", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 4, text="Δ Persist", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 5, text="Trend", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 6, text="WMA MTF", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 7, text="CMP", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 8, text="MTF", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 9, text="OFI Check", text_color=color.black, text_size=size.normal)
        table.cell(table_position, 0, 10, text="Confirm", text_color=color.black, text_size=size.normal)

    // Update dynamic values only
    quality_color = signal_quality >= 80 ? color.rgb(20, 103, 23) : signal_quality >= 60 ? color.rgb(75, 70, 17) : color.rgb(148, 35, 35)
    table.cell(table_position, 1, 0, text=bias_message, text_color=color.white, text_size=size.normal, bgcolor=bias_color)
    table.cell(table_position, 1, 1, text=str.tostring(signal_quality, "0.0") + "%", text_color=quality_color, text_size=size.normal)
    table.cell(table_position, 1, 2, text=str.tostring(volume_delta, "0.0"), text_color=delta_color, text_size=size.normal)
    table.cell(table_position, 1, 3, text=str.tostring(buy_sell_ratio, "0.00"), text_color=delta_color, text_size=size.normal)

    persist_text = strong_delta_bullish ? "BULL " + str.tostring(bullish_persistence * 100, "0") + "%" : strong_delta_bearish ? "BEAR " + str.tostring(bearish_persistence * 100, "0") + "%" : "NEUT"
    persist_color = strong_delta_bullish ? color.green : strong_delta_bearish ? color.red : color.gray
    table.cell(table_position, 1, 4, text=persist_text, text_color=persist_color, text_size=size.normal)

    trend_text = price_above_wma ? "BULL" : price_below_wma ? "BEAR" : "NEUT"
    trend_color = price_above_wma ? color.green : price_below_wma ? color.red : color.gray
    table.cell(table_position, 1, 5, text=trend_text, text_color=trend_color, text_size=size.normal)

    table.cell(table_position, 1, 6, text=str.tostring(wma_mtf_native, "0.00"), text_color=color.black, text_size=size.normal)

    price_color = price_above_wma ? color.green : price_below_wma ? color.red : color.gray
    table.cell(table_position, 1, 7, text=str.tostring(current_price, "0.00"), text_color=price_color, text_size=size.normal)

    table.cell(table_position, 1, 8, text=mtf_timeframe + " | Vol: " + str.tostring(mtf_volume, "0"), text_color=color.black, text_size=size.normal)

    ofi_text = delta_ofi_agreement ? "✓ AGREE" : "✗ DIVERG"
    ofi_color = delta_ofi_agreement ? color.green : color.red
    table.cell(table_position, 1, 9, text=ofi_text, text_color=ofi_color, text_size=size.normal)

    confirm_text = strong_bull ? "🟢🟢🟢🟢🟢" : neutral_bull ? "⚪⚪🟢🟢🟢" : neutral ? "⚪⚪⚪⚪⚪" : neutral_bear ? "⚪⚪🔴🔴🔴" : strong_bear ? "🔴🔴🔴🔴🔴" : "⚪⚪⚪"
    confirm_color = strong_bull ? color.green : neutral_bull ? color.new(color.green, 40) : neutral ? color.gray : neutral_bear ? color.new(color.red, 40) : color.red
    table.cell(table_position, 1, 10, text=confirm_text, text_color=confirm_color, text_size=size.normal)

// ================================================================================
// ALERTS (BATCHED)
// ================================================================================

if alert_enabled and barstate.islast
    delta_str = str.tostring(volume_delta, "0.0")
    ratio_str = str.tostring(buy_sell_ratio, "0.00")
    quality_str = str.tostring(signal_quality, "0.0")

    if strong_bull and not strong_bull[1]
        alert("🟢 STRONG BULL 🟢 🟢 🟢\nDelta: " + delta_str + " | Ratio: " + ratio_str + " | Quality: " + quality_str + "%", alert.freq_once_per_bar_close)

    if neutral_bull and not neutral_bull[1]
        alert("⚪ NEUTRAL BULL ⚪ 🟢 🟢\nDelta: " + delta_str + " | Ratio: " + ratio_str + " | Quality: " + quality_str + "%", alert.freq_once_per_bar_close)

    if neutral and not neutral[1]
        alert("⚪ NEUTRAL ⚪ ⚪ ⚪\nDelta: " + delta_str, alert.freq_once_per_bar_close)

    if neutral_bear and not neutral_bear[1]
        alert("⚪ NEUTRAL BEAR ⚪ 🔴 🔴\nDelta: " + delta_str + " | Ratio: " + ratio_str + " | Quality: " + quality_str + "%", alert.freq_once_per_bar_close)

    if strong_bear and not strong_bear[1]
        alert("🔴 STRONG BEAR 🔴 🔴 🔴\nDelta: " + delta_str + " | Ratio: " + ratio_str + " | Quality: " + quality_str + "%", alert.freq_once_per_bar_close)

// ================================================================================
// END - V7.5 PRODUCTION OPTIMIZED
// ================================================================================
