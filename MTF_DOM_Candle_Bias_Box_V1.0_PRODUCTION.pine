//@version=6
indicator("MTF DOM Candle Bias Box [Volume Ratio 1:2.5] V1.0", shorttitle="MTF DOM Candle Bias", overlay=false)

// ================================================================================
// MTF DOM Candle-based Buy/Sell Bias Box - PRODUCTION V1.0
// Buy Bias: Buy/Sell Volume Ratio >= 2.5:1 + WMA(1440) > Price (Bullish Trend)
// Sell Bias: Buy/Sell Volume Ratio <= 1:2.5 + WMA(1440) < Price (Bearish Trend)
// Alerts + Debug Table + WMA Visualization
// ================================================================================

// ================================================================================
// INPUT PARAMETERS
// ================================================================================

mtf_timeframe = input.timeframe("5", title="MTF DOM Timeframe (DOM Analysis)")
wma_length = input.int(20, title="WMA Length (Trend Confirmation)", minval=1, maxval=500)
volume_ratio_threshold = input.float(2.5, title="Volume Ratio Threshold (Buy:Sell)", minval=1.0, step=0.1)
show_debug_table = input.bool(true, title="Show Debug Info Table")
show_wma_plot = input.bool(true, title="Show WMA(1440) & Price Plot")
alert_enabled = input.bool(true, title="Enable Alerts")

// ================================================================================
// FETCH MTF DOM CANDLE DATA
// ================================================================================

mtf_open = request.security(syminfo.tickerid, mtf_timeframe, open)
mtf_high = request.security(syminfo.tickerid, mtf_timeframe, high)
mtf_low = request.security(syminfo.tickerid, mtf_timeframe, low)
mtf_close = request.security(syminfo.tickerid, mtf_timeframe, close)
mtf_volume = request.security(syminfo.tickerid, mtf_timeframe, volume)

// ================================================================================
// WMA TREND CALCULATION (Daily 1440 Timeframe)
// ================================================================================

wma_1440 = request.security(syminfo.tickerid, "1440", ta.wma(close, wma_length))
current_price = close

// ================================================================================
// DOM-BASED VOLUME RATIO ANALYSIS
// ================================================================================

// DOM Candle Interpretation:
// - Upper wick = Rejected buying pressure (supply)
// - Lower wick = Rejected selling pressure (demand)
// - Body = Net directional volume

// Buy/Sell Volume Proxies
mtf_buy_volume = math.max(mtf_high - mtf_open, 0) * mtf_volume
mtf_sell_volume = math.max(mtf_open - mtf_low, 0) * mtf_volume

// Safe division (avoid division by zero)
mtf_sell_volume_safe = mtf_sell_volume > 0 ? mtf_sell_volume : 0.001
mtf_buy_volume_safe = mtf_buy_volume > 0 ? mtf_buy_volume : 0.001

// Calculate ratios
buy_sell_ratio = mtf_buy_volume_safe / mtf_sell_volume_safe
sell_buy_ratio = mtf_sell_volume_safe / mtf_buy_volume_safe

// ================================================================================
// BIAS DETECTION LOGIC
// ================================================================================

// BUY BIAS: Volume ratio >= 2.5:1 AND WMA > Price
buy_volume_bias = buy_sell_ratio >= volume_ratio_threshold
wma_bullish_trend = wma_1440 > current_price
buy_bias_confirmed = buy_volume_bias and wma_bullish_trend

// SELL BIAS: Volume ratio <= 1:2.5 (Sell/Buy >= 2.5:1) AND WMA < Price
sell_volume_bias = sell_buy_ratio >= volume_ratio_threshold
wma_bearish_trend = wma_1440 < current_price
sell_bias_confirmed = sell_volume_bias and wma_bearish_trend

// NEUTRAL: Neither condition
neutral_bias = not buy_bias_confirmed and not sell_bias_confirmed

// ================================================================================
// COLOR DEFINITIONS
// ================================================================================

color_buy = color.new(color.green, 20)
color_sell = color.new(color.red, 20)
color_neutral = color.new(color.gray, 40)
color_buy_border = color.new(color.green, 0)
color_sell_border = color.new(color.red, 0)
color_neutral_border = color.new(color.gray, 0)

// ================================================================================
// DETERMINE BIAS STATUS & MESSAGING
// ================================================================================

bias_color = buy_bias_confirmed ? color_buy : sell_bias_confirmed ? color_sell : color_neutral
bias_border_color = buy_bias_confirmed ? color_buy_border : sell_bias_confirmed ? color_sell_border : color_neutral_border
bias_message = buy_bias_confirmed ? "BUY BIAS" : sell_bias_confirmed ? "SELL BIAS" : "NEUTRAL"

// ================================================================================
// BIAS BOX VISUALIZATION
// ================================================================================

var box bias_box = na

if barstate.islast
    // Remove old box
    if not na(bias_box)
        box.set_bgcolor(bias_box, bias_color)
        box.set_border_color(bias_box, bias_border_color)
        box.set_border_width(bias_box, 2)
        box.set_text(bias_box, bias_message)
    
    // Create new box
    bias_box := box.new(
         left=bar_index - 50,
         top=1.0,
         right=bar_index + 5,
         bottom=0.0,
         bgcolor=bias_color,
         border_color=bias_border_color,
         border_width=2,
         text=bias_message,
         text_size=size.large,
         text_color=color.white,
         text_halign=text.align_center,
         text_valign=text.align_center
         )

// ================================================================================
// WMA BAND VISUALIZATION
// ================================================================================

if show_wma_plot
    plot(wma_1440, title="WMA(1440) Trend", color=color.orange, linewidth=2)
    plot(current_price, title="Current Price", color=color.white, linewidth=1)

// ================================================================================
// DEBUG INFO TABLE (Bottom-Right)
// ================================================================================

if show_debug_table and barstate.islast
    table_position = table.new(
         position=position.bottom_right,
         columns=2,
         rows=8,
         bgcolor=color.new(color.black, 20),
         border_color=color.gray,
         border_width=1
         )
    
    // Row 1: Bias Status
    table.cell(table_position, 0, 0, text="[BIAS]", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 50))
    table.cell(table_position, 1, 0, text=bias_message, text_color=bias_border_color, text_size=size.small, bgcolor=bias_color)
    
    // Row 2: Buy/Sell Ratio
    table.cell(table_position, 0, 1, text="Buy:Sell Ratio", text_color=color.white, text_size=size.small)
    table.cell(table_position, 1, 1, text=str.tostring(buy_sell_ratio, "0.00"), text_color=color.yellow, text_size=size.small)
    
    // Row 3: Volume Bias Check
    table.cell(table_position, 0, 2, text="Vol Bias (≥2.5?)", text_color=color.white, text_size=size.small)
    volume_bias_text = buy_volume_bias ? "✓ BUY" : sell_volume_bias ? "✓ SELL" : "✗ NO"
    volume_bias_color = buy_volume_bias ? color.green : sell_volume_bias ? color.red : color.gray
    table.cell(table_position, 1, 2, text=volume_bias_text, text_color=volume_bias_color, text_size=size.small)
    
    // Row 4: WMA Value
    table.cell(table_position, 0, 3, text="WMA(1440)", text_color=color.white, text_size=size.small)
    table.cell(table_position, 1, 3, text=str.tostring(wma_1440, "0.00"), text_color=color.orange, text_size=size.small)
    
    // Row 5: Current Price
    table.cell(table_position, 0, 4, text="Current Price", text_color=color.white, text_size=size.small)
    table.cell(table_position, 1, 4, text=str.tostring(current_price, "0.00"), text_color=color.white, text_size=size.small)
    
    // Row 6: Trend Status
    table.cell(table_position, 0, 5, text="Trend Status", text_color=color.white, text_size=size.small)
    trend_text = wma_bullish_trend ? "✓ BULLISH" : wma_bearish_trend ? "✓ BEARISH" : "NEUTRAL"
    trend_color = wma_bullish_trend ? color.green : wma_bearish_trend ? color.red : color.gray
    table.cell(table_position, 1, 5, text=trend_text, text_color=trend_color, text_size=size.small)
    
    // Row 7: Confirmation
    table.cell(table_position, 0, 6, text="Confirmation", text_color=color.white, text_size=size.small)
    confirm_text = buy_bias_confirmed ? "✓ BUY CONF" : sell_bias_confirmed ? "✓ SELL CONF" : "✗ NEUTRAL"
    confirm_color = buy_bias_confirmed ? color.green : sell_bias_confirmed ? color.red : color.gray
    table.cell(table_position, 1, 6, text=confirm_text, text_color=confirm_color, text_size=size.small)
    
    // Row 8: MTF & Volume
    table.cell(table_position, 0, 7, text=str.format("MTF: {0}", mtf_timeframe), text_color=color.white, text_size=size.small)
    table.cell(table_position, 1, 7, text=str.format("Vol: {0}", str.tostring(mtf_volume, "0")), text_color=color.yellow, text_size=size.small)

// ================================================================================
// ALERTS
// ================================================================================

if alert_enabled
    // Buy Bias Alert (trigger once per confirmation)
    if buy_bias_confirmed and not buy_bias_confirmed[1]
        alert("🟢 MTF DOM: BUY BIAS CONFIRMED | Ratio: " + str.tostring(buy_sell_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)
    
    // Sell Bias Alert (trigger once per confirmation)
    if sell_bias_confirmed and not sell_bias_confirmed[1]
        alert("🔴 MTF DOM: SELL BIAS CONFIRMED | Ratio: " + str.tostring(sell_buy_ratio, "0.00") + ":1 | WMA: " + str.tostring(wma_1440, "0.00"), alert.freq_once_per_bar_close)

// ================================================================================
// EXPORTS FOR MULTI-INDICATOR STRATEGIES
// ================================================================================

export buy_bias_confirmed
export sell_bias_confirmed
export buy_sell_ratio
export sell_buy_ratio
export wma_1440
export wma_bullish_trend
export wma_bearish_trend
export current_price
export mtf_volume
