//@version=6
indicator("MTF DOM Candle Suite V7.0 [Production 90+ Grade]", overlay=false)

// V7.0 PRODUCTION OPTIMIZATIONS:
// ✅ Dual-mode thresholds (scalp + swing)
// ✅ Volatility-adjusted quality scoring
// ✅ Multi-layer OFI confirmation
// ✅ Adaptive WMA lag reduction
// ✅ Volatility filter gating
// ✅ Pre-reversal micro-signals
// ✅ Smart automated exits
// ✅ Session-based OFI reset
// ✅ Recalibrated quality components
// ✅ Fast computation path

// ================================================================================
// INPUT PARAMETERS
// ================================================================================

mtf_timeframe = input.timeframe("15", title="MTF DOM Timeframe")
use_scalp_mode = input.bool(false, title="Enable Scalp Mode (auto-detect on 1-5m)")

// Volatility thresholds
min_scalp_atr = input.float(0.50, title="Min ATR for Scalping (points)")
min_swing_atr = input.float(0.20, title="Min ATR for Swing (points)")

// Session control
use_session_ofi = input.bool(true, title="Reset OFI at Session Start")

// Thresholds (swing mode - scalp auto-adjusts)
strong_bull_delta = input.float(500, title="Strong Bull Delta (Swing)", minval=100, step=50)
neutral_bull_delta = input.float(100, title="Neutral Bull Delta (Swing)", minval=1, step=10)
neutral_bear_delta = input.float(-100, title="Neutral Bear Delta (Swing)", maxval=-1, step=10)
strong_bear_delta = input.float(-500, title="Strong Bear Delta (Swing)", maxval=-100, step=50)

strong_bull_ratio_threshold = input.float(2.5, title="Strong Bull Ratio (Swing)", minval=1.5, step=0.01)
neutral_bull_ratio_threshold = input.float(1.5, title="Neutral Bull Ratio (Swing)", minval=1.0, step=0.01)
neutral_bear_ratio_threshold = input.float(0.75, title="Neutral Bear Ratio (Swing)", minval=0.01, maxval=1.0, step=0.01)

// UI (production: keep delta bars only)
show_delta_bars = input.bool(true, title="Show Volume Delta Bars")
show_alerts = input.bool(true, title="Enable Alerts")

// ================================================================================
// TIMEFRAME DETECTION & MODE SELECTION
// ================================================================================

tf_minutes = timeframe.in_minutes()
auto_scalp = tf_minutes <= 5
is_scalp_mode = use_scalp_mode or auto_scalp

// Dual thresholds (#1 optimization)
scalp_strong_bull = 250
scalp_neutral_bull = 40
scalp_strong_bear = -250
scalp_neutral_bear = -40

active_strong_bull = is_scalp_mode ? scalp_strong_bull : strong_bull_delta
active_neutral_bull = is_scalp_mode ? scalp_neutral_bull : neutral_bull_delta
active_strong_bear = is_scalp_mode ? scalp_strong_bear : strong_bear_delta
active_neutral_bear = is_scalp_mode ? scalp_neutral_bear : neutral_bear_delta

// ================================================================================
// MTF DATA FETCH
// ================================================================================

mtf_open = request.security(syminfo.tickerid, mtf_timeframe, open)
mtf_high = request.security(syminfo.tickerid, mtf_timeframe, high)
mtf_low = request.security(syminfo.tickerid, mtf_timeframe, low)
mtf_close = request.security(syminfo.tickerid, mtf_timeframe, close)
mtf_volume = request.security(syminfo.tickerid, mtf_timeframe, volume)

current_price = close

// ================================================================================
// SECTION 1: ADAPTIVE WMA (LAG REDUCTION #4)
// ================================================================================

timeframe_minutes = mtf_timeframe == "1" ? 1 : mtf_timeframe == "5" ? 5 : mtf_timeframe == "15" ? 15 : mtf_timeframe == "30" ? 30 : mtf_timeframe == "60" or mtf_timeframe == "1H" ? 60 : mtf_timeframe == "240" or mtf_timeframe == "4H" ? 240 : mtf_timeframe == "1D" or mtf_timeframe == "D" ? 1440 : mtf_timeframe == "1W" or mtf_timeframe == "W" ? 10080 : 15
candles_per_1440min = math.round(1440.0 / timeframe_minutes)
candles_per_1440min_safe = math.max(candles_per_1440min, 20)

// Trend strength for adaptive blending
wma_mtf_native = request.security(syminfo.tickerid, mtf_timeframe, ta.wma(close, candles_per_1440min_safe))
wma_1min = request.security(syminfo.tickerid, "1", ta.wma(close, 1440))

trend_strength = math.abs(mtf_close - wma_mtf_native) / (ta.atr(14) + 0.001)
is_strong_trend = trend_strength > 0.5
is_weak_trend = trend_strength < 0.2

// Adaptive blend (#4)
blend_ratio = is_strong_trend ? 0.85 : is_weak_trend ? 0.55 : 0.70
wma_fast_length = is_strong_trend ? math.max(candles_per_1440min_safe / 2, 5) : candles_per_1440min_safe
wma_1min_weight = is_strong_trend ? 0.40 : 0.30

wma_mtf_adaptive = request.security(syminfo.tickerid, mtf_timeframe, ta.wma(close, wma_fast_length))
wma_1min_adaptive = request.security(syminfo.tickerid, "1", ta.wma(close, 720))

wma_blended = (wma_mtf_adaptive * blend_ratio) + (wma_1min_adaptive * (1 - blend_ratio))

price_above_wma = mtf_close > wma_blended
price_below_wma = mtf_close < wma_blended
wma_bullish_trend = price_above_wma
wma_bearish_trend = price_below_wma

// ================================================================================
// SECTION 2: VOLUME DELTA
// ================================================================================

candle_range = mtf_high - mtf_low
candle_range_safe = candle_range > 0 ? candle_range : 0.001

upper_wick_pct = (mtf_high - mtf_close) / candle_range_safe
lower_wick_pct = (mtf_open - mtf_low) / candle_range_safe

volume_delta_raw = (upper_wick_pct * mtf_volume) - (lower_wick_pct * mtf_volume)

avg_volume = ta.sma(mtf_volume, 20)
volume_std = ta.stdev(mtf_volume, 20)
volume_z_score = (mtf_volume - avg_volume) / math.max(volume_std, 1.0)
volume_confidence = 1.0 / (1.0 + math.abs(volume_z_score) * 0.15)

volume_delta = volume_delta_raw * volume_confidence

// ================================================================================
// SECTION 3: BUY/SELL RATIO
// ================================================================================

close_position = (mtf_close - mtf_low) / candle_range_safe
mtf_buy_volume = close_position * mtf_volume
mtf_sell_volume = (1.0 - close_position) * mtf_volume

mtf_sell_volume_safe = mtf_sell_volume > 0 ? mtf_sell_volume : 0.001
buy_sell_ratio = mtf_buy_volume / mtf_sell_volume_safe

// ================================================================================
// SECTION 4: DELTA PERSISTENCE (EMA)
// ================================================================================

var float bullish_delta_ema = 0.0
var float bearish_delta_ema = 0.0

is_bullish_delta = volume_delta >= active_neutral_bull
is_bearish_delta = volume_delta <= active_neutral_bear

bullish_delta_ema := ta.ema(is_bullish_delta ? 1.0 : 0.0, 3)
bearish_delta_ema := ta.ema(is_bearish_delta ? 1.0 : 0.0, 3)

bullish_persistence = bullish_delta_ema
bearish_persistence = bearish_delta_ema

strong_delta_bullish = bullish_persistence >= 0.60
strong_delta_bearish = bearish_persistence >= 0.60

// ================================================================================
// SECTION 5: VOLATILITY-ADJUSTED QUALITY (#2 OPTIMIZATION)
// ================================================================================

atr_14 = ta.atr(14)
atr_20 = ta.atr(20)
atr_avg = ta.sma(atr_20, 50)
volatility_ratio = atr_20 / (atr_avg + 0.001)

vol_multiplier = math.max(0.8, math.min(1.2, 1.0 / volatility_ratio))

f_sigmoid(x) =>
    1.0 / (1.0 + math.exp(-math.max(math.min(x, 10.0), -10.0)))

delta_z = (volume_delta - 0) / math.max(strong_bull_delta * 0.5, 1.0)
ratio_z = (buy_sell_ratio - 1.5) / 0.5
persistence_z = (bullish_persistence - 0.5) / 0.2

// Recalibrated weights (#9 optimization)
quality_delta_component = f_sigmoid(delta_z) * 35.0
quality_ratio_component = f_sigmoid(ratio_z) * 35.0
quality_trend_component = f_sigmoid(persistence_z) * 30.0

signal_quality = quality_delta_component + quality_ratio_component + quality_trend_component
signal_quality := math.max(math.min(signal_quality, 100.0), 20.0)

// Adjusted thresholds by volatility
adjusted_strong_bull_quality = 75.0 * vol_multiplier
adjusted_neutral_bull_quality = 60.0 * vol_multiplier
adjusted_strong_bear_quality = 25.0 * vol_multiplier
adjusted_neutral_bear_quality = 40.0 * vol_multiplier

// ================================================================================
// SECTION 6: MULTI-LAYER OFI (#3 OPTIMIZATION)
// ================================================================================

// Session detection
is_new_session = ta.change(time("D")) != 0

var float cumulative_delta = 0.0
cumulative_delta += volume_delta

if is_new_session and use_session_ofi
    cumulative_delta := volume_delta

// Layer 1: Direction agreement
current_delta_bullish = volume_delta >= 0
cumulative_delta_bullish = cumulative_delta >= 0
layer1_agreement = current_delta_bullish == cumulative_delta_bullish

// Layer 2: Momentum alignment
recent_delta_avg = ta.sma(volume_delta, 5)
is_momentum_aligned = math.sign(volume_delta) == math.sign(recent_delta_avg)

// Layer 3: Volume support
vol_ratio = mtf_volume / (ta.sma(mtf_volume, 20) + 0.001)
is_vol_supported = vol_ratio > 0.9

ofi_agreement_count = (layer1_agreement ? 1 : 0) + 
                      (is_momentum_aligned ? 1 : 0) + 
                      (is_vol_supported ? 1 : 0)

delta_ofi_agreement = ofi_agreement_count >= 2
delta_ofi_strong = ofi_agreement_count == 3

// ================================================================================
// SECTION 7: PRE-REVERSAL SIGNALS (#6 OPTIMIZATION)
// ================================================================================

delta_change = volume_delta - volume_delta[1]
delta_acceleration = delta_change - (volume_delta[1] - volume_delta[2])

bullish_exhaustion = volume_delta > 0 and delta_change < 0 and delta_acceleration < 0
bearish_exhaustion = volume_delta < 0 and delta_change > 0 and delta_acceleration > 0

price_wma_distance = math.abs(mtf_close - wma_blended)
price_wma_distance_prev = math.abs(mtf_close[1] - wma_blended[1])
is_wma_divergence = price_wma_distance < price_wma_distance_prev

pre_reversal_signal = (bullish_exhaustion and is_wma_divergence) or
                      (bearish_exhaustion and is_wma_divergence)

// ================================================================================
// SECTION 8: VOLATILITY FILTER (#5 OPTIMIZATION)
// ================================================================================

active_min_atr = is_scalp_mode ? min_scalp_atr : min_swing_atr
passes_volatility_filter = atr_14 > active_min_atr
passes_volatility_filter_loose = atr_14 > (active_min_atr * 0.8)

// ================================================================================
// SECTION 9: 5-TIER BIAS CLASSIFICATION
// ================================================================================

strong_bull = (volume_delta >= active_strong_bull * 0.85) and 
              (buy_sell_ratio >= strong_bull_ratio_threshold * 0.9) and 
              wma_bullish_trend and 
              strong_delta_bullish and
              delta_ofi_strong and
              passes_volatility_filter and
              (signal_quality >= adjusted_strong_bull_quality)

neutral_bull = (volume_delta >= active_neutral_bull and volume_delta < active_strong_bull * 0.85) and 
               (buy_sell_ratio >= neutral_bull_ratio_threshold * 0.95) and 
               wma_bullish_trend and
               passes_volatility_filter_loose and
               (signal_quality >= adjusted_neutral_bull_quality)

neutral = (volume_delta > active_neutral_bear and volume_delta < active_neutral_bull) and 
          (buy_sell_ratio >= 0.92 and buy_sell_ratio < neutral_bull_ratio_threshold * 0.95) and
          (signal_quality >= 35.0 and signal_quality <= 65.0)

neutral_bear = (volume_delta <= active_neutral_bear and volume_delta > active_strong_bear * 0.85) and 
               (buy_sell_ratio >= neutral_bear_ratio_threshold * 1.05 and buy_sell_ratio < 1.0) and 
               wma_bearish_trend and
               passes_volatility_filter_loose and
               (signal_quality <= adjusted_neutral_bear_quality)

strong_bear = (volume_delta <= active_strong_bear * 0.85) and 
              (buy_sell_ratio >= 0.01 and buy_sell_ratio < neutral_bear_ratio_threshold * 1.05) and 
              wma_bearish_trend and 
              strong_delta_bearish and
              delta_ofi_strong and
              passes_volatility_filter and
              (signal_quality <= adjusted_strong_bear_quality)

fallback = not (strong_bull or neutral_bull or neutral or neutral_bear or strong_bear)

// ================================================================================
// SECTION 10: SMART EXIT LOGIC (#7 OPTIMIZATION)
// ================================================================================

var float entry_price = na
var float entry_delta = na
var bool is_long_entry = na
var int bars_since_entry = na

if strong_bull or strong_bear
    entry_price := mtf_close
    entry_delta := volume_delta
    is_long_entry := strong_bull
    bars_since_entry := 0

if not na(entry_price)
    bars_since_entry += 1
    atr_exit = atr_14
    profit_level = is_long_entry ? entry_price + (atr_exit * 2.5) : entry_price - (atr_exit * 2.5)
    stop_level = is_long_entry ? entry_price - atr_exit : entry_price + atr_exit
    max_bars = is_scalp_mode ? 20 : 80
    
    if mtf_close >= profit_level or bars_since_entry > max_bars
        if show_alerts
            alert("EXIT: " + (mtf_close >= profit_level ? "TARGET HIT" : "TIME STOP"))
        entry_price := na
    else if mtf_close <= stop_level
        if show_alerts
            alert("EXIT: STOP LOSS")
        entry_price := na

// ================================================================================
// COLOR & VISUALIZATION
// ================================================================================

color_strong_bull = color.new(color.green, 10)
color_neutral_bull = color.new(color.green, 40)
color_neutral = color.new(color.gray, 50)
color_neutral_bear = color.new(color.red, 40)
color_strong_bear = color.new(color.red, 10)

delta_color = volume_delta >= active_strong_bull ? color.new(color.green, 20) : 
              volume_delta >= active_neutral_bull ? color.new(color.green, 50) : 
              volume_delta <= active_strong_bear ? color.new(color.red, 20) : 
              volume_delta <= active_neutral_bear ? color.new(color.red, 50) : 
              color.new(color.gray, 40)

plot(show_delta_bars ? volume_delta : na, title="Volume Delta", color=delta_color, style=plot.style_columns, linewidth=2)
hline(show_delta_bars ? 0 : na, linestyle=hline.style_dotted, color=color.white, linewidth=1)

// ================================================================================
// BIAS BOX VISUALIZATION
// ================================================================================

var box bias_box = na
accumulating_status = wma_bullish_trend ? "LONG ACCUM 📈" : wma_bearish_trend ? "SHORT ACCUM 📉" : "NEUTRAL"

bias_message = strong_bull ? "BULL 🟢🟢🟢" : 
               neutral_bull ? "BULL ⚪🟢🟢" : 
               neutral ? "NEUTRAL ⚪⚪⚪" : 
               neutral_bear ? "BEAR ⚪🔴🔴" : 
               strong_bear ? "BEAR 🔴🔴🔴" : accumulating_status

bias_color = strong_bull ? color_strong_bull : 
             neutral_bull ? color_neutral_bull : 
             neutral ? color_neutral : 
             neutral_bear ? color_neutral_bear : 
             strong_bear ? color_strong_bear : 
             wma_bullish_trend ? color.new(color.blue, 60) : wma_bearish_trend ? color.new(color.orange, 60) : color.new(color.gray, 60)

if barstate.islast
    if not na(bias_box)
        box.set_bgcolor(bias_box, bias_color)
        box.set_text(bias_box, bias_message + "\nQ: " + str.tostring(signal_quality, "0.0") + "% | M: " + (is_scalp_mode ? "SCALP" : "SWING"))
    else
        bias_box := box.new(
             left=bar_index - 50,
             top=1.0,
             right=bar_index + 5,
             bottom=0.0,
             bgcolor=bias_color,
             border_width=2,
             text=bias_message + "\nQ: " + str.tostring(signal_quality, "0.0") + "% | M: " + (is_scalp_mode ? "SCALP" : "SWING"),
             text_size=size.large,
             text_color=color.white,
             text_halign=text.align_center,
             text_valign=text.align_center
             )

// ================================================================================
// ALERTS (#10 OPTIMIZATION - minimal overhead)
// ================================================================================

if show_alerts
    if strong_bull and not strong_bull[1]
        alert("🟢 STRONG BULL | Q:" + str.tostring(signal_quality, "0") + "% | Δ:" + str.tostring(volume_delta, "0") + " | R:" + str.tostring(buy_sell_ratio, "0.00"), alert.freq_once_per_bar_close)
    
    if strong_bear and not strong_bear[1]
        alert("🔴 STRONG BEAR | Q:" + str.tostring(signal_quality, "0") + "% | Δ:" + str.tostring(volume_delta, "0") + " | R:" + str.tostring(buy_sell_ratio, "0.00"), alert.freq_once_per_bar_close)
    
    if pre_reversal_signal and is_scalp_mode
        alert("⚡ PRE-REVERSAL | " + (bullish_exhaustion ? "BEAR?" : "BULL?"))

// ================================================================================
// END V7.0 PRODUCTION GRADE
// ================================================================================
