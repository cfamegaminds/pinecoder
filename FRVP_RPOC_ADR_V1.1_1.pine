//@version=6
indicator("FRVP + RPOC + ICT ADR Confluence Engine [3:30] V1.1", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000)

// ════════════════════════════════════════════════════════
// ── SECTION 1 : FRVP INPUTS  (POCF)
// ════════════════════════════════════════════════════════
rows           = input.int(24,    "Profile Rows",        minval=10, maxval=100)
profilesToShow = input.int(30,    "Profiles To Plot",    minval=1,  maxval=50)
pocWidth       = input.int(4,     "POC Width",           minval=1,  maxval=10)
pocColor       = input.color(color.blue, "POC Color")
extendIntoNext = input.bool(true, "Extend POC Across Next Session")

// ════════════════════════════════════════════════════════
// ── SECTION 2 : RPOC INPUTS  (POCR)
// ════════════════════════════════════════════════════════
resInput       = input.timeframe("D", "Segment Resolution", options=["D","W","M"])
minBars        = input.int(1,    "Minimum Bars Required",   minval=1)
binsCount      = input.int(480,  "Volume Profile Bins",     minval=10)
pocThreshold   = input.float(0.0,"POC Update Threshold %",  step=0.01,
     tooltip="POC only updates when new value differs by more than this % from previous POC.")
smoothedLength = input.int(60,   "POC Smoothing Length",    minval=1)
updateMinutes  = input.int(1440, "POC Update Interval (Minutes)", minval=1)
profilePoc     = input.color(color.red, "RPOC Color")
rpocWidth      = input.int(4,    "RPOC Line Width",         minval=1, maxval=10)

// ════════════════════════════════════════════════════════
// ── SECTION 3 : ADR INPUTS
// ════════════════════════════════════════════════════════
i_len  = input.int(5, "ADR Lookback", group="ADR Settings")

i_100 = input.bool(true,  "100% ADR",  group="ADR Levels")
i_66  = input.bool(true,  "66% ADR",   group="ADR Levels")
i_50  = input.bool(false, "50% ADR",   group="ADR Levels")
i_33  = input.bool(true,  "33% ADR",   group="ADR Levels")
i_anl = input.bool(true,  "Anchor",    group="ADR Levels")

c100  = input.color(#FF4757, "100% Color", group="ADR Colors")
c66   = input.color(#FF6348, "66% Color",  group="ADR Colors")
c50   = input.color(#FFA502, "50% Color",  group="ADR Colors")
c33   = input.color(#2ED573, "33% Color",  group="ADR Colors")
canch = input.color(color.black, "Anchor Color", group="ADR Colors")

highlightBull = color.new(color.green, 0)
highlightBear = color.new(color.red,   0)
highlightText = color.white
bgNeutral     = color.new(color.black, 100)

// ════════════════════════════════════════════════════════
// ── SECTION 4 : SESSION (3:30 IST)  — shared anchor
// ════════════════════════════════════════════════════════
string tz      = "Asia/Kolkata"
istHour        = hour(time,   tz)
istMinute      = minute(time, tz)
newSession     = istHour == 3 and istMinute == 30

// ── FRVP session tracking ──
var int[] sessionStarts = array.new_int()
var int[] sessionEnds   = array.new_int()

if newSession
    if array.size(sessionStarts) > array.size(sessionEnds)
        array.push(sessionEnds, bar_index - 1)
    array.push(sessionStarts, bar_index)
    while array.size(sessionStarts) > profilesToShow + 1
        array.shift(sessionStarts)
    while array.size(sessionEnds) > profilesToShow
        array.shift(sessionEnds)

// ── ADR session high/low tracking ──
var float curr_high = na
var float curr_low  = na

if newSession
    curr_high := high
    curr_low  := low
else
    curr_high := na(curr_high) ? high : math.max(curr_high, high)
    curr_low  := na(curr_low)  ? low  : math.min(curr_low,  low)

var float prev_high = na
var float prev_low  = na

if newSession
    prev_high := curr_high[1]
    prev_low  := curr_low[1]

// ════════════════════════════════════════════════════════
// ── SECTION 5 : OTE ZONE  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
fib_lower = 0.79
fib_upper = 0.90

var float pH = na
var float pL = na

if newSession and not na(prev_high)
    myRange = prev_high - prev_low
    pH := prev_high - myRange * fib_lower
    pL := prev_high - myRange * fib_upper

phPlot = plot(pH, color=color.white, linewidth=1, display=display.none)
plPlot = plot(pL, color=color.white, linewidth=1, display=display.none)
fill(phPlot, plPlot, color=#6d0140)

// ════════════════════════════════════════════════════════
// ── SECTION 6 : ZoB  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
var float zob = na

if newSession and not na(prev_high)
    zob := (prev_high + prev_low) / 2

plot(zob, "ZoB", color=color.blue, linewidth=2)

// ════════════════════════════════════════════════════════
// ── SECTION 7 : ADR ENGINE  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
d_high = request.security(syminfo.tickerid, "D", high[1])
d_low  = request.security(syminfo.tickerid, "D", low[1])

adr_raw = ta.sma(d_high - d_low, i_len)

var float adr = na
isNewDay = timeframe.change("D")

if isNewDay
    adr := adr_raw

adr := nz(adr, adr_raw)

// ════════════════════════════════════════════════════════
// ── SECTION 8 : ANCHOR  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
var float anchor = na

if newSession
    anchor := open

anchor := nz(anchor, anchor[1])

// ════════════════════════════════════════════════════════
// ── SECTION 9 : ADR LEVELS  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
l100_up = anchor + adr
l100_dn = anchor - adr

l66_up  = anchor + adr * 0.66
l66_dn  = anchor - adr * 0.66

l33_up  = anchor + adr * 0.33
l33_dn  = anchor - adr * 0.33

// ── Custom ADR Zones ──
zone075_low  = anchor + (adr * 0.65 / 2)
zone080_high = anchor + (adr * 0.75 / 2)
pZone075 = plot(zone075_low,  color=color.new(color.gray, 100), title="+0.75 ADR Zone Low")
pZone080 = plot(zone080_high, color=color.new(color.gray, 100), title="+0.80 ADR Zone High")
fill(pZone075, pZone080, color=color.new(color.gray, 20))

zone095_low   = anchor + (adr * 1.2 / 2)
zone0975_high = anchor + (adr * 1.3 / 2)
pZone095  = plot(zone095_low,   color=color.new(color.gray, 100), title="+0.95 ADR Zone Low")
pZone0975 = plot(zone0975_high, color=color.new(color.gray, 100), title="+0.975 ADR Zone High")
fill(pZone095, pZone0975, color=color.new(color.gray, 20))

zone025_low = anchor - adr * 0.265
zone030_low = anchor - adr * 0.325
pZone025 = plot(zone025_low, color=color.new(#8B0000, 100), title="Discount Zone Low")
pZone030 = plot(zone030_low, color=color.new(#8B0000, 100), title="Discount Zone High")
fill(pZone025, pZone030, color=color.new(#8B0000, 40))

// ── ADR Plots ──
plot(i_anl ? anchor  : na, "Anchor",    canch, linewidth=2, style=plot.style_linebr)
plot(i_100 ? l100_up : na, "+1.33 ADR", c100)
plot(i_100 ? l100_dn : na, "-0.33 ADR", c100)
plot(i_66  ? l66_up  : na, "+1 ADR",    c66)
plot(i_66  ? l66_dn  : na, "0 ADR",     c66)
plot(i_33  ? l33_up  : na, "+0.75 ADR", c33)
plot(i_33  ? l33_dn  : na, "+0.25 ADR", c33)

// ════════════════════════════════════════════════════════
// ── SECTION 10 : LAST TOUCHED  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
var int lastTouched = na

if isNewDay
    lastTouched := na

touch_025       = low <= l33_dn  and high >= l33_dn
touch_0         = low <= l66_dn  and high >= l66_dn
touch_n33       = low <= l100_dn and high >= l100_dn
touch_p075      = low <= l33_up  and high >= l33_up
touch_p1        = low <= l66_up  and high >= l66_up
touch_p133      = low <= l100_up and high >= l100_up

bull_anchor_reject = low  < anchor and close > anchor
bear_anchor_reject = high > anchor and close < anchor

if touch_p133
    lastTouched := 6
else if touch_p1
    lastTouched := 5
else if touch_p075
    lastTouched := 4
else if touch_n33
    lastTouched := 3
else if touch_0
    lastTouched := 2
else if bull_anchor_reject
    lastTouched := 10
else if bear_anchor_reject
    lastTouched := 11
else if touch_025
    lastTouched := 1

// ════════════════════════════════════════════════════════
// ── SECTION 11 : ICT EXECUTION ENGINE  (from ICT_ADR330)
// ════════════════════════════════════════════════════════
inOTE = not na(pH) and not na(pL) and close <= pH and close >= pL

sweep_bull = low  < l100_dn and close > l100_dn
sweep_bear = high > l100_up and close < l100_up

longCondition  = sweep_bull and inOTE and bull_anchor_reject
shortCondition = sweep_bear and inOTE and bear_anchor_reject

alertcondition(longCondition,  "ICT BUY",  "ICT Long Setup")
alertcondition(shortCondition, "ICT SELL", "ICT Short Setup")

// ════════════════════════════════════════════════════════
// ── SECTION 12 : FRVP POC / VAH / VAL CALCULATION
// ════════════════════════════════════════════════════════
calcProfileLevels(_startBar, _endBar, _rows) =>
    float hi = na
    float lo = na
    safeStart = math.max(_startBar, bar_index - 4999)

    for i = safeStart to _endBar
        barsBack = bar_index - i
        if barsBack >= 0 and barsBack < 5000
            hi := na(hi) ? high[barsBack] : math.max(hi, high[barsBack])
            lo := na(lo) ? low[barsBack]  : math.min(lo, low[barsBack])

    if na(hi) or na(lo)
        [na, na, na, na, na]
    else
        myRange    = math.max(hi - lo, syminfo.mintick)
        step       = myRange / _rows
        volumeRows = array.new_float(_rows, 0.0)
        totalVol   = 0.0

        for i = safeStart to _endBar
            barsBack = bar_index - i
            if barsBack >= 0 and barsBack < 5000
                barHigh  = high[barsBack]
                barLow   = low[barsBack]
                barVol   = volume[barsBack]
                totalVol += barVol
                barRange = math.max(barHigh - barLow, syminfo.mintick)

                for r = 0 to _rows - 1
                    rowLow  = lo + step * r
                    rowHigh = rowLow + step
                    overlap = math.max(math.min(barHigh, rowHigh) - math.max(barLow, rowLow), 0)
                    if overlap > 0
                        array.set(volumeRows, r, array.get(volumeRows, r) + barVol * (overlap / barRange))

        maxVol = 0.0
        pocRow = 0
        for r = 0 to _rows - 1
            rowVol = array.get(volumeRows, r)
            if rowVol > maxVol
                maxVol := rowVol
                pocRow := r

        poc = lo + step * pocRow + step * 0.5

        targetVol = totalVol * 0.79
        valueVol  = maxVol
        vahRow    = pocRow
        valRow    = pocRow
        upRow     = pocRow + 1
        downRow   = pocRow - 1

        while valueVol < targetVol and (upRow < _rows or downRow >= 0)
            volUp   = upRow   < _rows and upRow   >= 0 ? array.get(volumeRows, upRow)   : 0.0
            volDown = downRow >= 0     and downRow < _rows ? array.get(volumeRows, downRow) : 0.0

            if volUp >= volDown
                if upRow < _rows
                    valueVol += volUp
                    vahRow    := upRow
                    upRow     += 1
                else
                    if downRow >= 0
                        valueVol += volDown
                        valRow    := downRow
                        downRow   -= 1
            else
                if downRow >= 0
                    valueVol += volDown
                    valRow    := downRow
                    downRow   -= 1
                else
                    if upRow < _rows
                        valueVol += volUp
                        vahRow    := upRow
                        upRow     += 1

        vah = lo + step * vahRow + step
        val = lo + step * valRow

        [poc, vah, val, hi, lo]

// ════════════════════════════════════════════════════════
// ── SECTION 13 : RPOC CALCULATION
// ════════════════════════════════════════════════════════
isNewSegment  = timeframe.change(resInput)
var int segmentStart = bar_index

if isNewSegment
    segmentStart := bar_index

segmentLength = bar_index - segmentStart + 1
devHigh       = ta.highest(high, segmentLength)
devLow        = ta.lowest(low,  segmentLength)

float rawPocPrice = na
range_  = devHigh - devLow
stepR   = range_ / binsCount
binsVol = array.new_float(binsCount, 0.0)

for i = 0 to binsCount - 1
    array.set(binsVol, i, 0.0)

if segmentLength >= minBars and range_ > 0 and stepR > 0
    for i = 0 to segmentLength - 1
        price = close[i]
        vol   = volume[i]
        idx   = math.floor((price - devLow) / stepR)
        idx  := math.max(0, math.min(binsCount - 1, idx))
        array.set(binsVol, idx, array.get(binsVol, idx) + vol)

    maxVolR  = array.max(binsVol)
    pocIndex = array.indexof(binsVol, maxVolR)
    if pocIndex >= 0
        rawPocPrice := devLow + (stepR * pocIndex) + (stepR / 2)

var float smoothedRawPoc    = na
var float currentStablePoc  = na
var int   lastUpdateTime    = na

if isNewSegment
    currentStablePoc := na
    smoothedRawPoc   := na
    lastUpdateTime   := na

if not na(rawPocPrice)
    smoothedRawPoc := na(smoothedRawPoc) ? rawPocPrice : ((smoothedRawPoc * (smoothedLength - 1)) + rawPocPrice) / smoothedLength

updateIntervalMs = updateMinutes * 60 * 1000
canUpdate        = na(lastUpdateTime) or ((time - lastUpdateTime) >= updateIntervalMs)

if not na(smoothedRawPoc)
    if na(currentStablePoc)
        currentStablePoc := smoothedRawPoc
        lastUpdateTime   := time
    else
        diffPercent = math.abs(smoothedRawPoc - currentStablePoc) / currentStablePoc * 100
        if canUpdate and diffPercent > pocThreshold
            currentStablePoc := smoothedRawPoc
            lastUpdateTime   := time

float POCR = currentStablePoc

// ════════════════════════════════════════════════════════
// ── SECTION 14 : DAY OPEN LEVEL
// ════════════════════════════════════════════════════════
var float dayOpen = na
if isNewDay or na(dayOpen)
    dayOpen := open
float DayOpenLevel = dayOpen

// ════════════════════════════════════════════════════════
// ── SECTION 15 : FRVP TABLE  (bottom-left)
// ════════════════════════════════════════════════════════
var table controlTable = table.new(position.bottom_left, 2, 5, border_width=1)

var float POCF       = na
var float VAL_Last   = na
var float VAH_Last   = na
var bool  isBullish  = false
var bool  isBearish  = false
var bool  isBalanced = false

if barstate.islast and array.size(sessionEnds) > 0
    latestStart = array.get(sessionStarts, math.min(array.size(sessionStarts)-1, array.size(sessionEnds)-1))
    latestEnd   = array.get(sessionEnds, array.size(sessionEnds)-1)

    [pocNow, vahNow, valNow, hiNow, loNow] = calcProfileLevels(latestStart, latestEnd, rows)

    if not na(pocNow)
        POCF     := pocNow
        VAL_Last := valNow
        VAH_Last := vahNow

        pocP1Range = math.abs(vahNow - pocNow)
        pocD1Range = math.abs(pocNow - valNow)

        isBullish  := pocP1Range > pocD1Range * 1.25
        isBearish  := pocD1Range > pocP1Range * 1.25
        isBalanced := not isBullish and not isBearish

        boxColor = isBullish ? color.new(color.green, 0) : isBearish ? color.new(color.red, 0) : color.new(color.orange, 0)
        bias     = isBullish ? "▲ Bullish" : isBearish ? "▼ Bearish" : "◆ Balanced"

        table.cell(controlTable, 0, 0, "FRVP Levels",                bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.large)
        table.cell(controlTable, 1, 0, "Value",                      bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.large)
        table.cell(controlTable, 0, 1, "POC",                        bgcolor=color.new(color.blue,  20), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 1, str.tostring(pocNow, "#.##"), bgcolor=color.new(color.blue,  20), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 0, 2, "P1 (VAH)",                   bgcolor=color.new(color.green, 30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 2, str.tostring(vahNow, "#.##"), bgcolor=color.new(color.green, 30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 0, 3, "D1 (VAL)",                   bgcolor=color.new(color.red,   30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 3, str.tostring(valNow, "#.##"), bgcolor=color.new(color.red,   30), text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 0, 4, "Bias",                       bgcolor=boxColor,                   text_color=color.white, text_size=size.normal)
        table.cell(controlTable, 1, 4, bias,                         bgcolor=boxColor,                   text_color=color.white, text_size=size.normal)

// ════════════════════════════════════════════════════════
// ── SECTION 16 : CONFLUENCE FLAGS
// ════════════════════════════════════════════════════════
// Position flags for POCR, D1, Anchor relative to OTE zone
pocrInOTE    = not na(POCR)     and not na(pL) and not na(pH) and POCR     >= pL and POCR     <= pH
pocrBelowOTE = not na(POCR)     and not na(pL)                and POCR     <  pL
d1InOTE      = not na(VAL_Last) and not na(pL) and not na(pH) and VAL_Last >= pL and VAL_Last <= pH
d1BelowOTE   = not na(VAL_Last) and not na(pL)                and VAL_Last <  pL
anchorInOTE  = not na(anchor)   and not na(pL) and not na(pH) and anchor   >= pL and anchor   <= pH

// ── Anchor Trending flag : Anchor AND POCR both inside OTE ───────────────
anchorTrending = anchorInOTE and pocrInOTE

// ── Case A : POCR below D1 (both below OTE) ──────────────────────────────
caseA_row3 = pocrBelowOTE and d1BelowOTE and not na(VAL_Last) and POCR < VAL_Last
caseA_row4 = d1InOTE

// ── Case B : POCR inside OTE, D1 below OTE ───────────────────────────────
caseB = pocrInOTE and d1BelowOTE

// ── Case C : Both POCR and D1 inside OTE ─────────────────────────────────
caseC = pocrInOTE and d1InOTE

// ── Combined triggers (bearish context applied in bias box) ───────────────
showPOCRMsg = caseA_row3 or caseB or caseC
showD1Msg   = caseA_row4 or caseB or caseC

// ════════════════════════════════════════════════════════
// ── SECTION 16B : BULLISH SEQUENTIAL SCENARIO FLAGS
// ════════════════════════════════════════════════════════
// All state vars reset at each new session anchor

// ── Scenario 1 : DayOpen > POCF  (Bearish Reversal sequence) ─────────────
// Step 1 : P1 (VAH) liquidity taken   → high touches or exceeds VAH
// Step 2 : POCF liquidity taken       → low touches or breaks below POCF  (after step 1)
// Step 3 : D1 (VAL) liquidity taken   → low touches or breaks below VAL   (after step 2)

var bool s1_p1_taken   = false   // VAH swept
var bool s1_pocf_taken = false   // POCF broken after VAH sweep
var bool s1_d1_taken   = false   // D1 broken after POCF breakdown

if newSession
    s1_p1_taken   := false
    s1_pocf_taken := false
    s1_d1_taken   := false

if isBullish and DayOpenLevel > POCF and not na(VAH_Last)
    if not s1_p1_taken and high >= VAH_Last
        s1_p1_taken := true
    if s1_p1_taken and not s1_pocf_taken and low <= POCF
        s1_pocf_taken := true
    if s1_pocf_taken and not s1_d1_taken and low <= VAL_Last
        s1_d1_taken := true

// ── Scenario 2 : DayOpen < POCF  (Bullish Breakout sequence) ─────────────
// Step 1 : D1 (VAL) liquidity taken   → low touches or breaks below VAL
// Step 2 : POCF liquidity taken       → high touches or exceeds POCF       (after step 1)
// Step 3 : P1 (VAH) breakout          → high touches or exceeds VAH        (after step 2)

var bool s2_d1_taken   = false   // D1 swept
var bool s2_pocf_taken = false   // POCF broken above after D1 sweep
var bool s2_p1_taken   = false   // P1 breakout completed after POCF breakout

if newSession
    s2_d1_taken   := false
    s2_pocf_taken := false
    s2_p1_taken   := false

if isBullish and DayOpenLevel < POCF and not na(VAL_Last)
    if not s2_d1_taken and low <= VAL_Last
        s2_d1_taken := true
    if s2_d1_taken and not s2_pocf_taken and high >= POCF
        s2_pocf_taken := true
    if s2_pocf_taken and not s2_p1_taken and high >= VAH_Last
        s2_p1_taken := true

// ════════════════════════════════════════════════════════
// ── SECTION 17 : BIAS INFO BOX  (bottom-right)
// ════════════════════════════════════════════════════════
// 7-row table: header | line1 | line2 | POCR/scenario row | D1/scenario row | scenario row 5 | scenario row 6
var table biasBox = table.new(position.bottom_right, 1, 7, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

if barstate.islast and not na(POCF) and not na(POCR) and not na(DayOpenLevel)
    highLevel = math.max(POCF, POCR)
    lowLevel  = math.min(POCF, POCR)
    highDay   = math.max(POCF, DayOpenLevel)
    lowDay    = math.min(POCF, DayOpenLevel)

    highLevelStr = str.tostring(highLevel, "#.##")
    lowLevelStr  = str.tostring(lowLevel,  "#.##")
    highDayStr   = str.tostring(highDay,   "#.##")
    lowDayStr    = str.tostring(lowDay,    "#.##")

    pocfStr = str.tostring(POCF,     "#.##")
    d1Str   = str.tostring(VAL_Last, "#.##")
    p1Str   = str.tostring(VAH_Last, "#.##")

    blankCell = color.new(color.black, 100)

    if isBearish
        // ── Header ──
        bearHeader = anchorTrending ? "⚠ BEARISH BIAS ⚡ Anchor Trending!!!" : "⚠ BEARISH BIAS"
        table.cell(biasBox, 0, 0, bearHeader,
             bgcolor=color.new(color.red, 10), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 1, "Sellers in Control below " + lowLevelStr,
             bgcolor=color.new(color.red, 30), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 2, "Buyers back in Control above " + highLevelStr,
             bgcolor=color.new(color.green, 40), text_color=color.white, text_size=size.large)

        // Row 3 : POCR breakdown message
        if showPOCRMsg
            pocrStr = str.tostring(POCR, "#.##")
            table.cell(biasBox, 0, 3, "POCR(" + pocrStr + ") 🔻 Breakdown Expected!!!",
                 bgcolor=color.new(color.red, 0), text_color=color.white, text_size=size.large)
        else
            table.cell(biasBox, 0, 3, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

        // Row 4 : D1 breakdown message
        if showD1Msg
            table.cell(biasBox, 0, 4, "💥 D1(" + d1Str + ") Breakdown Expected!!!",
                 bgcolor=color.new(color.purple, 10), text_color=color.white, text_size=size.large)
        else
            table.cell(biasBox, 0, 4, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

        // Rows 5–6 : blank (bearish has no scenario 1/2 messages)
        table.cell(biasBox, 0, 5, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
        table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

    else if isBullish
        // ── Header ──
        bullHeader = anchorTrending ? "✔ BULLISH BIAS ⚡ Anchor Trending!!!" : "✔ BULLISH BIAS"
        table.cell(biasBox, 0, 0, bullHeader,
             bgcolor=color.new(color.green, 10), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 1, "Buyers in Control above " + highLevelStr,
             bgcolor=color.new(color.green, 30), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 2, "Sellers back in Control below " + lowLevelStr,
             bgcolor=color.new(color.red, 40), text_color=color.white, text_size=size.large)

        // Rows 3–4 : blank (no POCR/D1 breakdown msgs in bullish)
        table.cell(biasBox, 0, 3, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
        table.cell(biasBox, 0, 4, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

        // ── Scenario 1 : DayOpen > POCF  (Bearish Reversal sequence) ──────
        if DayOpenLevel > POCF
            // Step 2 reached → POCF breakdown (show after P1 + POCF both taken)
            if s1_pocf_taken and not s1_d1_taken
                table.cell(biasBox, 0, 5, "🔻 POCF(" + pocfStr + ") Breakdown!!! Selloff Expected",
                     bgcolor=color.new(color.red, 10), text_color=color.white, text_size=size.large)
                table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

            // Step 3 reached → D1 breakdown (show after POCF + D1 both taken)
            else if s1_d1_taken
                table.cell(biasBox, 0, 5, "🔻 POCF(" + pocfStr + ") Breakdown!!! Selloff Expected",
                     bgcolor=color.new(color.red, 10), text_color=color.white, text_size=size.large)
                table.cell(biasBox, 0, 6, "🔻 D1(" + d1Str + ") Breakdown!!! Selloff Expected",
                     bgcolor=color.new(color.red, 0), text_color=color.white, text_size=size.large)

            // No sequence reached yet
            else
                table.cell(biasBox, 0, 5, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
                table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

        // ── Scenario 2 : DayOpen < POCF  (Bullish Breakout sequence) ───────
        else if DayOpenLevel < POCF
            // Step 2 reached → POCF breakout (show after D1 + POCF both taken)
            if s2_pocf_taken and not s2_p1_taken
                table.cell(biasBox, 0, 5, "🚀 POCF(" + pocfStr + ") Breakout!!! Breakout Expected",
                     bgcolor=color.new(color.green, 10), text_color=color.white, text_size=size.large)
                table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

            // Step 3 reached → P1 breakout completed
            else if s2_p1_taken
                table.cell(biasBox, 0, 5, "🚀 POCF(" + pocfStr + ") Breakout!!! Breakout Expected",
                     bgcolor=color.new(color.green, 10), text_color=color.white, text_size=size.large)
                table.cell(biasBox, 0, 6, "✅ P1(" + p1Str + ") Breakout!!! Breakout Completed",
                     bgcolor=color.new(color.green, 0), text_color=color.white, text_size=size.large)

            // No sequence reached yet
            else
                table.cell(biasBox, 0, 5, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
                table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

        else
            table.cell(biasBox, 0, 5, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
            table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

    else if isBalanced
        table.cell(biasBox, 0, 0, "◆ BALANCED BIAS",
             bgcolor=color.new(color.orange, 10), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 1, "Buyers in Control above " + highDayStr,
             bgcolor=color.new(color.green, 40), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 2, "Sellers back in Control below " + lowDayStr,
             bgcolor=color.new(color.red, 40), text_color=color.white, text_size=size.large)
        table.cell(biasBox, 0, 3, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
        table.cell(biasBox, 0, 4, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
        table.cell(biasBox, 0, 5, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)
        table.cell(biasBox, 0, 6, "", bgcolor=blankCell, text_color=color.white, text_size=size.normal)

// ════════════════════════════════════════════════════════
// ── SECTION 18 : ADR PANEL  (top-right)
// ════════════════════════════════════════════════════════
var table panel = table.new(position.top_right, 2, 25)

f_fmt(v) =>
    na(v) ? "-" : str.tostring(v, format.mintick)

bias      = close > anchor ? "BULLISH" : "BEARISH"
biasColor = close > anchor ? color.green : color.red

inPremium     = close > l66_up
inDiscount    = close < l66_dn
inEquilibrium = not inPremium and not inDiscount

if barstate.islast
    int row = 0

    table.cell(panel, 0, row, "ICT ADR PRO", text_color=color.white, bgcolor=color.black)
    table.cell(panel, 1, row, bias, text_color=color.white, bgcolor=biasColor)
    row += 1

    table.cell(panel, 0, row, "ADR")
    table.cell(panel, 1, row, f_fmt(adr))
    row += 1

    table.cell(panel, 0, row, "──── PREMIUM ────", text_color=color.red)
    table.cell(panel, 1, row, inPremium ? "ACTIVE" : "")
    row += 1

    if i_100
        bg = lastTouched == 6 ? highlightBear : bgNeutral
        table.cell(panel, 0, row, "+1.33 ADR", text_color=c100)
        table.cell(panel, 1, row, f_fmt(l100_up), bgcolor=bg, text_color=color.white)
        row += 1

    if i_66
        bg = lastTouched == 5 ? highlightBear : bgNeutral
        table.cell(panel, 0, row, "+1 ADR", text_color=c66)
        table.cell(panel, 1, row, f_fmt(l66_up), bgcolor=bg, text_color=color.white)
        row += 1

    if i_33
        bg = lastTouched == 4 ? highlightBear : bgNeutral
        table.cell(panel, 0, row, "+0.75 ADR", text_color=c33)
        table.cell(panel, 1, row, f_fmt(l33_up), bgcolor=bg, text_color=color.white)
        row += 1

    table.cell(panel, 0, row, "──── EQ ────", text_color=color.orange)
    table.cell(panel, 1, row, inEquilibrium ? "ACTIVE" : "")
    row += 1

    if i_anl
        bg =
             lastTouched == 10 ? highlightBull :
             lastTouched == 11 ? highlightBear :
             bgNeutral
        table.cell(panel, 0, row, "Anchor", text_color=canch)
        table.cell(panel, 1, row, f_fmt(anchor), bgcolor=bg, text_color=color.white)
        row += 1

    if i_33
        bg = lastTouched == 1 ? highlightBull : bgNeutral
        table.cell(panel, 0, row, "+0.25 ADR", text_color=c33)
        table.cell(panel, 1, row, f_fmt(l33_dn), bgcolor=bg, text_color=color.white)
        row += 1

    table.cell(panel, 0, row, "──── DISCOUNT ────", text_color=color.green)
    table.cell(panel, 1, row, inDiscount ? "ACTIVE" : "")
    row += 1

    if i_66
        bg = lastTouched == 2 ? highlightBear : bgNeutral
        table.cell(panel, 0, row, "0 ADR", text_color=c66)
        table.cell(panel, 1, row, f_fmt(l66_dn), bgcolor=bg, text_color=color.white)
        row += 1

    if i_100
        bg = lastTouched == 3 ? highlightBear : bgNeutral
        table.cell(panel, 0, row, "-0.33 ADR", text_color=c100)
        table.cell(panel, 1, row, f_fmt(l100_dn), bgcolor=bg, text_color=color.white)

// ════════════════════════════════════════════════════════
// ── SECTION 19 : RPOC PLOT
// ════════════════════════════════════════════════════════
plot(isNewSegment ? na : POCR, title="RPOC (POCR)", color=profilePoc, linewidth=rpocWidth, style=plot.style_line)
